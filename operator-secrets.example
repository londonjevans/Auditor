# Copy this template to a private operator path; mmaudit never loads a target .env.
OPENROUTER_API_KEY=replace-with-an-openrouter-key

# Optional helper variable for your own scripts. mmaudit expects --repo to point to a local checkout.
AUDIT_TARGET=https://github.com/londonjevans/Auditor.git

# Optional local fork endpoint for explicitly enabled fork-only Foundry probing.
# Prefer a local Anvil/Hardhat node such as http://127.0.0.1:8545.
MMAUDIT_FORK_RPC_URL=http://127.0.0.1:8545
