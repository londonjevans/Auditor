{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmaudit.local/schemas/benchmark_manifest.schema.json",
  "title": "mmaudit self-hashed benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "blinding",
    "repositories",
    "cases",
    "corpus_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "blinding": {
      "$ref": "#/$defs/blinding"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports_generated_before_ground_truth",
        "ground_truth_disclosure"
      ],
      "properties": {
        "reports_generated_before_ground_truth": {
          "const": true
        },
        "ground_truth_disclosure": {
          "const": "post_run_only"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "source_root"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_id",
        "variant",
        "category",
        "path",
        "start_line",
        "end_line",
        "source_sha256",
        "minimum_severity",
        "expected_cwe",
        "source_attribution",
        "training_exposure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "variant": {
          "enum": [
            "vulnerable",
            "safe",
            "ambiguous"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "minimum_severity": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "expected_cwe": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          }
        },
        "source_attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "training_exposure": {
          "enum": [
            "unlikely",
            "possible",
            "known",
            "unknown"
          ]
        }
      }
    }
  }
}
