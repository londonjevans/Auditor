{
  "$defs": {
    "ManifestFileBinding": {
      "additionalProperties": false,
      "description": "Hash and size for one normalized source or run-artifact path.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ManifestFileBinding",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/release_artifact_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed release observation over files that were actually emitted.",
  "properties": {
    "artifact_count": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Artifact Count",
      "type": "integer"
    },
    "artifact_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Inventory Sha256",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ManifestFileBinding"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "manifest_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest File Sha256",
      "type": "string"
    },
    "manifest_path": {
      "const": "run-evidence-manifest.json",
      "title": "Manifest Path",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "traceability_path": {
      "const": "maximum_assurance_traceability.json",
      "title": "Traceability Path",
      "type": "string"
    },
    "traceability_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Traceability Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "run_id",
    "manifest_path",
    "manifest_file_sha256",
    "manifest_sha256",
    "artifact_count",
    "artifact_inventory_sha256",
    "artifacts",
    "traceability_path",
    "traceability_sha256",
    "evidence_sha256"
  ],
  "title": "mmaudit observed release artifact evidence",
  "type": "object"
}
