{
  "$defs": {
    "JUnitValidationStatus": {
      "description": "Typed state for the fixed pytest JUnit artifact.",
      "enum": [
        "not_applicable",
        "valid",
        "empty",
        "invalid"
      ],
      "title": "JUnitValidationStatus",
      "type": "string"
    },
    "ManifestFileBinding": {
      "additionalProperties": false,
      "description": "Hash and size for one normalized source or run-artifact path.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ManifestFileBinding",
      "type": "object"
    },
    "PytestJUnitCounts": {
      "additionalProperties": false,
      "description": "Nonempty bounded aggregate parsed from pytest's local JUnit XML.",
      "properties": {
        "errors": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failures": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "passed": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "tests": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Tests",
          "type": "integer"
        }
      },
      "required": [
        "tests",
        "passed",
        "failures",
        "errors",
        "skipped"
      ],
      "title": "PytestJUnitCounts",
      "type": "object"
    },
    "ReleaseGateFixedPlan": {
      "additionalProperties": false,
      "description": "Self-hashed canonical plan used to prevent receipt semantic replay.",
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Arguments",
          "type": "array"
        },
        "child_environment_contract_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Environment Contract Sha256"
        },
        "executor": {
          "$ref": "#/$defs/ReleaseGatePlanExecutor"
        },
        "fixed_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixed Plan Sha256",
          "type": "string"
        },
        "gate_id": {
          "$ref": "#/$defs/ReleaseGateId"
        },
        "generated_by": {
          "const": "mmaudit",
          "title": "Generated By",
          "type": "string"
        },
        "max_output_bytes": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "network_allowed": {
          "const": false,
          "title": "Network Allowed",
          "type": "boolean"
        },
        "network_guard_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Guard Sha256"
        },
        "python_safe_path": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Python Safe Path"
        },
        "result_artifact_path": {
          "pattern": "^release-gate-[a-z0-9_]+-result\\.json$",
          "title": "Result Artifact Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_contract": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Semantic Contract",
          "type": "string"
        },
        "supplemental_artifact_path": {
          "anyOf": [
            {
              "pattern": "^release-gate-[a-z0-9_]+-[a-z0-9_-]+\\.[a-z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplemental Artifact Path"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "schema_version",
        "generated_by",
        "gate_id",
        "executor",
        "semantic_contract",
        "arguments",
        "max_output_bytes",
        "python_safe_path",
        "result_artifact_path",
        "network_allowed",
        "fixed_plan_sha256"
      ],
      "title": "ReleaseGateFixedPlan",
      "type": "object"
    },
    "ReleaseGateId": {
      "description": "The exact fixed twelve-gate release portfolio.",
      "enum": [
        "artifacts",
        "benchmark_certificate",
        "doctor",
        "manifests",
        "maximum_assurance_run",
        "model_benchmark",
        "mypy",
        "pytest",
        "replay",
        "ruff_check",
        "ruff_format",
        "schemas"
      ],
      "title": "ReleaseGateId",
      "type": "string"
    },
    "ReleaseGatePlanExecutor": {
      "description": "Closed executor family for one release-gate semantic contract.",
      "enum": [
        "fixed_local_python_module",
        "bound_runtime_observation"
      ],
      "title": "ReleaseGatePlanExecutor",
      "type": "string"
    },
    "ReleaseGateStatus": {
      "description": "One derived gate outcome.",
      "enum": [
        "passed",
        "blocked_technical",
        "failed"
      ],
      "title": "ReleaseGateStatus",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/release_local_gate_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed runtime result that carries candidate, run, and plan provenance.",
  "properties": {
    "argv": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 3,
      "title": "Argv",
      "type": "array"
    },
    "argv_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Argv Sha256",
      "type": "string"
    },
    "candidate_observation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Observation Sha256",
      "type": "string"
    },
    "child_environment_contract": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 100,
      "minProperties": 1,
      "title": "Child Environment Contract",
      "type": "object"
    },
    "child_environment_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Child Environment Contract Sha256",
      "type": "string"
    },
    "child_environment_keys": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Child Environment Keys",
      "type": "array"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "execution_evidence": {
      "const": "real",
      "title": "Execution Evidence",
      "type": "string"
    },
    "gate_id": {
      "$ref": "#/$defs/ReleaseGateId"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "junit_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ManifestFileBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "junit_counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/PytestJUnitCounts"
        },
        {
          "type": "null"
        }
      ]
    },
    "junit_status": {
      "$ref": "#/$defs/JUnitValidationStatus"
    },
    "max_output_bytes": {
      "maximum": 4194304,
      "minimum": 1,
      "title": "Max Output Bytes",
      "type": "integer"
    },
    "network_guard_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Network Guard Sha256",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ReleaseGateFixedPlan"
    },
    "process_exit_code": {
      "anyOf": [
        {
          "maximum": 255,
          "minimum": -255,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Process Exit Code"
    },
    "provider_access": {
      "const": "disabled",
      "title": "Provider Access",
      "type": "string"
    },
    "python_executable_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Python Executable Sha256",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Binding Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReleaseGateStatus"
    },
    "stderr_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stderr Sha256",
      "type": "string"
    },
    "stderr_size": {
      "maximum": 4194304,
      "minimum": 0,
      "title": "Stderr Size",
      "type": "integer"
    },
    "stdout_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stdout Sha256",
      "type": "string"
    },
    "stdout_size": {
      "maximum": 4194304,
      "minimum": 0,
      "title": "Stdout Size",
      "type": "integer"
    },
    "timed_out": {
      "title": "Timed Out",
      "type": "boolean"
    },
    "timeout_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "tool_distribution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Distribution Sha256",
      "type": "string"
    },
    "tool_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "gate_id",
    "candidate_observation_sha256",
    "run_binding_sha256",
    "plan",
    "status",
    "started_at",
    "ended_at",
    "argv",
    "argv_sha256",
    "tool_name",
    "tool_version",
    "python_executable_sha256",
    "tool_distribution_sha256",
    "execution_evidence",
    "timed_out",
    "timeout_seconds",
    "max_output_bytes",
    "stdout_size",
    "stdout_sha256",
    "stderr_size",
    "stderr_sha256",
    "child_environment_keys",
    "child_environment_contract",
    "child_environment_contract_sha256",
    "network_guard_sha256",
    "provider_access",
    "junit_status",
    "junit_counts",
    "junit_binding",
    "result_sha256"
  ],
  "title": "LocalReleaseGateResult",
  "type": "object"
}
