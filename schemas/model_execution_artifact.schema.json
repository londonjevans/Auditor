    "provider_endpoints",
    "usage",
    "prompt_tokens",
    "completion_tokens",
    "reasoning_tokens",
    "cached_tokens",
    "accounted_cost_usd",
    "accounted_cost_usd_exact",
    "budget_usd",
    "privacy_profile",
    "source_code_egress_enabled",
    "raw_prompts_retained",
