{
  "$defs": {
    "AnalysisState": {
      "description": "Evidence-aware state used by engines and coverage reports.",
      "enum": [
        "not_analyzed",
        "attempted_but_failed",
        "analyzed_with_fallback_parser",
        "model_only",
        "scanner_supported",
        "deterministic",
        "reproduced",
        "formally_proven"
      ],
      "title": "AnalysisState",
      "type": "string"
    },
    "AuditQualityStatus": {
      "enum": [
        "completed",
        "completed_with_limitations",
        "incomplete",
        "failed",
        "environment_unsafe",
        "target_unsupported"
      ],
      "title": "AuditQualityStatus",
      "type": "string"
    },
    "AuditRunStatus": {
      "description": "Evidence-derived terminal state for an audit run.",
      "enum": [
        "COMPLETE",
        "DEGRADED",
        "INCOMPLETE",
        "FAILED"
      ],
      "title": "AuditRunStatus",
      "type": "string"
    },
    "CostEntryStatus": {
      "description": "Persisted lifecycle state for one unique provider request.",
      "enum": [
        "reserved",
        "reconciled",
        "released",
        "uncertain_accounted",
        "reservation_overrun"
      ],
      "title": "CostEntryStatus",
      "type": "string"
    },
    "CostLedgerAbsenceEvidence": {
      "additionalProperties": false,
      "description": "Typed zero-usage state that never invents a ledger snapshot.",
      "properties": {
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "persistent_ledger_configured": {
          "title": "Persistent Ledger Configured",
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "NO_MODEL_USAGE_AND_NO_PERSISTENT_LEDGER",
            "NO_MODEL_USAGE_AND_NO_CAMPAIGN_LEDGER_EVIDENCE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "run_entry_count": {
          "const": 0,
          "default": 0,
          "title": "Run Entry Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "ABSENT_ZERO",
            "UNESTABLISHED_ZERO"
          ],
          "title": "State",
          "type": "string"
        },
        "status": {
          "enum": [
            "NOT_APPLICABLE",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        },
        "usage_record_count": {
          "const": 0,
          "default": 0,
          "title": "Usage Record Count",
          "type": "integer"
        }
      },
      "required": [
        "state",
        "status",
        "reason",
        "persistent_ledger_configured",
        "evidence_sha256"
      ],
      "title": "CostLedgerAbsenceEvidence",
      "type": "object"
    },
    "CostLedgerAttemptEvidence": {
      "additionalProperties": false,
      "description": "One terminal campaign reservation with an optional exact usage join.",
      "properties": {
        "accounted_cost_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Accounted Cost Usd Exact",
          "type": "string"
        },
        "attempt_index": {
          "maximum": 6,
          "minimum": 1,
          "title": "Attempt Index",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "ledger_entry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Entry Sha256",
          "type": "string"
        },
        "logical_request_id": {
          "pattern": "^scheduler-request-[0-9a-f]{64}$",
          "title": "Logical Request Id",
          "type": "string"
        },
        "reconciled_cost_usd_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciled Cost Usd Exact"
        },
        "release_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "released_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Released Usd Exact",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "reservation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Reservation Id",
          "type": "string"
        },
        "reserved_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Reserved Usd Exact",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CostEntryStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "usage_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Record Sha256"
        }
      },
      "required": [
        "logical_request_id",
        "attempt_index",
        "request_id",
        "reservation_id",
        "status",
        "release_reason",
        "reserved_usd_exact",
        "accounted_cost_usd_exact",
        "released_usd_exact",
        "created_at",
        "updated_at",
        "ledger_entry_sha256"
      ],
      "title": "CostLedgerAttemptEvidence",
      "type": "object"
    },
    "ExecutionEvidenceKind": {
      "description": "Whether a runtime record came from a real process or a test double.",
      "enum": [
        "real",
        "mock",
        "unverified"
      ],
      "title": "ExecutionEvidenceKind",
      "type": "string"
    },
    "ModelRequestValidationStatus": {
      "description": "Fail-closed terminal validation state for one provider request.",
      "enum": [
        "not_validated",
        "valid",
        "invalid_response",
        "truncated",
        "model_mismatch",
        "provider_mismatch",
        "provider_error"
      ],
      "title": "ModelRequestValidationStatus",
      "type": "string"
    },
    "OpenRouterIdentityStrength": {
      "description": "Strength of a completed model and provider identity observation.\n\n``CANONICAL_MODEL_AND_ENDPOINT_BOUND`` is a policy-constrained OpenRouter\nbinding: exact ``provider.only`` routing, no fallback, router observations,\nand generation metadata agree. OpenRouter does not expose a documented\npreflight-tag to post-call endpoint-ID join, so this is not a cryptographic\nprovider-deployment attestation.",
      "enum": [
        "IMMUTABLE_VERSION_BOUND",
        "CANONICAL_MODEL_AND_ENDPOINT_BOUND",
        "UNBOUND"
      ],
      "title": "OpenRouterIdentityStrength",
      "type": "string"
    },
    "QualityGateResult": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/AnalysisState",
          "default": "not_analyzed"
        }
      },
      "required": [
        "gate",
        "required",
        "passed",
        "detail"
      ],
      "title": "QualityGateResult",
      "type": "object"
    },
    "ReasoningControlProfile": {
      "additionalProperties": false,
      "description": "One effective reasoning control with an explicit token reservation.",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "exclude": {
          "default": false,
          "title": "Exclude",
          "type": "boolean"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "mode": {
          "enum": [
            "disabled",
            "default",
            "effort",
            "max_tokens"
          ],
          "title": "Mode",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "reserved_reasoning_tokens": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Reserved Reasoning Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "reserved_reasoning_tokens",
        "profile_sha256"
      ],
      "title": "ReasoningControlProfile",
      "type": "object"
    },
    "ReasoningExecutionEvidence": {
      "additionalProperties": false,
      "description": "Provider accounting joined to the exact pre-transport reasoning plan.",
      "properties": {
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "observation_available": {
          "title": "Observation Available",
          "type": "boolean"
        },
        "observed_reasoning_tokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Reasoning Tokens"
        },
        "provider_completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Completion Tokens"
        },
        "request_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Body Sha256",
          "type": "string"
        },
        "request_plan": {
          "$ref": "#/$defs/ReasoningRequestPlanEvidence"
        },
        "request_token_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Token Plan Sha256",
          "type": "string"
        },
        "reserved_reasoning_tokens": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Reserved Reasoning Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "disabled_observed",
            "disabled_unreported",
            "active_observed",
            "active_unavailable",
            "failed_before_observation"
          ],
          "title": "State",
          "type": "string"
        },
        "visible_completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Completion Tokens"
        }
      },
      "required": [
        "request_plan",
        "reserved_reasoning_tokens",
        "observation_available",
        "state",
        "request_token_plan_sha256",
        "request_body_sha256",
        "evidence_sha256"
      ],
      "title": "ReasoningExecutionEvidence",
      "type": "object"
    },
    "ReasoningRequestPlanEvidence": {
      "additionalProperties": false,
      "description": "Exact role, control, capability, and qualification joins for one request plan.",
      "properties": {
        "binding_state": {
          "enum": [
            "policy_only",
            "capability_bound",
            "qualification_bound"
          ],
          "title": "Binding State",
          "type": "string"
        },
        "control_profile": {
          "$ref": "#/$defs/ReasoningControlProfile"
        },
        "endpoint_capability_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Capability Sha256"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "policy_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Artifact Sha256",
          "type": "string"
        },
        "policy_role_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Role Binding Sha256",
          "type": "string"
        },
        "qualification_binding_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Binding Sha256"
        },
        "resolution": {
          "$ref": "#/$defs/ReasoningRequestRoleResolution"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resolution",
        "control_profile",
        "policy_artifact_sha256",
        "policy_role_binding_sha256",
        "binding_state",
        "evidence_sha256"
      ],
      "title": "ReasoningRequestPlanEvidence",
      "type": "object"
    },
    "ReasoningRequestRoleResolution": {
      "additionalProperties": false,
      "description": "Exact host request-role meaning, policy routing, and qualification role.",
      "properties": {
        "configured_policy_role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Configured Policy Role",
          "type": "string"
        },
        "mapping_kind": {
          "enum": [
            "base_exact",
            "specialist_investigator",
            "specialist_auxiliary",
            "dedicated_exploit_test",
            "fallback_exploit_test",
            "falsifier_fallback",
            "candidate_cross_examination_context",
            "candidate_cross_examination",
            "whole_protocol_indexed",
            "prequalification_benchmark",
            "prequalification_role_benchmark"
          ],
          "title": "Mapping Kind",
          "type": "string"
        },
        "qualification_role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Qualification Role",
          "type": "string"
        },
        "request_role": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Request Role",
          "type": "string"
        },
        "resolution_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolution Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Semantic Role",
          "type": "string"
        }
      },
      "required": [
        "request_role",
        "semantic_role",
        "configured_policy_role",
        "qualification_role",
        "mapping_kind",
        "resolution_sha256"
      ],
      "title": "ReasoningRequestRoleResolution",
      "type": "object"
    },
    "ReleaseReason": {
      "description": "Closed release reasons that cannot carry arbitrary or secret text.",
      "enum": [
        "cancelled_before_send",
        "failed_before_send"
      ],
      "title": "ReleaseReason",
      "type": "string"
    },
    "RunCostLedgerEvidence": {
      "additionalProperties": false,
      "description": "Exact campaign-only delta between immutable atomic ledger snapshots.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/CostLedgerAttemptEvidence"
          },
          "maxItems": 1000000,
          "title": "Attempts",
          "type": "array"
        },
        "baseline_active_reserved_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Baseline Active Reserved Usd Exact",
          "type": "string"
        },
        "baseline_entry_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Baseline Entry Count",
          "type": "integer"
        },
        "baseline_has_reservation_overrun": {
          "title": "Baseline Has Reservation Overrun",
          "type": "boolean"
        },
        "baseline_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Sha256",
          "type": "string"
        },
        "baseline_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Snapshot Sha256",
          "type": "string"
        },
        "baseline_spent_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Baseline Spent Usd Exact",
          "type": "string"
        },
        "cap_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Cap Usd Exact",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "final_active_reserved_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Final Active Reserved Usd Exact",
          "type": "string"
        },
        "final_entry_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Final Entry Count",
          "type": "integer"
        },
        "final_has_reservation_overrun": {
          "title": "Final Has Reservation Overrun",
          "type": "boolean"
        },
        "final_over_cap": {
          "title": "Final Over Cap",
          "type": "boolean"
        },
        "final_remaining_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Final Remaining Usd Exact",
          "type": "string"
        },
        "final_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Snapshot Sha256",
          "type": "string"
        },
        "final_spent_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Final Spent Usd Exact",
          "type": "string"
        },
        "run_accounted_cost_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Run Accounted Cost Usd Exact",
          "type": "string"
        },
        "run_entry_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Run Entry Count",
          "type": "integer"
        },
        "run_released_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Run Released Usd Exact",
          "type": "string"
        },
        "run_reserved_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
          "title": "Run Reserved Usd Exact",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "const": "RUN_SCOPED_CLOSED",
          "default": "RUN_SCOPED_CLOSED",
          "title": "State",
          "type": "string"
        },
        "status": {
          "const": "VALIDATED",
          "default": "VALIDATED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "baseline_sha256",
        "baseline_snapshot_sha256",
        "final_snapshot_sha256",
        "cap_usd_exact",
        "baseline_spent_usd_exact",
        "baseline_active_reserved_usd_exact",
        "final_spent_usd_exact",
        "final_active_reserved_usd_exact",
        "final_remaining_usd_exact",
        "run_reserved_usd_exact",
        "run_accounted_cost_usd_exact",
        "run_released_usd_exact",
        "baseline_entry_count",
        "final_entry_count",
        "run_entry_count",
        "final_over_cap",
        "baseline_has_reservation_overrun",
        "final_has_reservation_overrun",
        "attempts",
        "evidence_sha256"
      ],
      "title": "RunCostLedgerEvidence",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "accounted_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Accounted Cost Usd",
          "type": "number"
        },
        "accounted_cost_usd_exact": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,36})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accounted Cost Usd Exact"
        },
        "actual_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "actual_provider_endpoint": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Provider Endpoint"
        },
        "attempts": {
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "configured_provider_endpoints": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Configured Provider Endpoints",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
