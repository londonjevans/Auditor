  "$id": "https://mmaudit.local/schemas/model_execution_artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-secret model execution and cost evidence for the forensic bundle.",
  "properties": {
    "accounted_cost_usd": {
      "minimum": 0,
      "title": "Accounted Cost Usd",
      "type": "number"
    },
    "accounted_cost_usd_exact": {
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,36})?$",
      "title": "Accounted Cost Usd Exact",
      "type": "string"
    },
    "actual_models": {
      "items": {
        "type": "string"
      },
      "title": "Actual Models",
      "type": "array"
    },
    "budget_usd": {
      "minimum": 0,
      "title": "Budget Usd",
      "type": "number"
    },
    "cached_tokens": {
      "minimum": 0,
      "title": "Cached Tokens",
      "type": "integer"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "completion_tokens": {
      "minimum": 0,
      "title": "Completion Tokens",
      "type": "integer"
    },
    "configured_fallbacks": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Configured Fallbacks",
      "type": "object"
    },
    "configured_models": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Configured Models",
      "type": "object"
    },
    "cost_ledger": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLedgerAbsenceEvidence"
        },
        {
          "$ref": "#/$defs/RunCostLedgerEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Ledger"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "privacy_profile": {
      "title": "Privacy Profile",
      "type": "string"
    },
    "prompt_tokens": {
      "minimum": 0,
      "title": "Prompt Tokens",
      "type": "integer"
    },
    "provider_endpoints": {
      "items": {
        "type": "string"
      },
      "title": "Provider Endpoints",
      "type": "array"
    },
    "quality_gates": {
      "items": {
        "$ref": "#/$defs/QualityGateResult"
      },
      "title": "Quality Gates",
      "type": "array"
    },
    "quality_status": {
      "$ref": "#/$defs/AuditQualityStatus"
    },
    "raw_prompts_retained": {
      "title": "Raw Prompts Retained",
      "type": "boolean"
    },
    "raw_responses_retained": {
      "title": "Raw Responses Retained",
      "type": "boolean"
    },
    "reasoning_tokens": {
      "minimum": 0,
      "title": "Reasoning Tokens",
      "type": "integer"
    },
    "requested_models": {
      "items": {
        "type": "string"
      },
      "title": "Requested Models",
      "type": "array"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/AuditRunStatus"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
