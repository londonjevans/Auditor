{
  "$defs": {
    "AnalysisState": {
      "description": "Evidence-aware state used by engines and coverage reports.",
      "enum": [
        "not_analyzed",
        "attempted_but_failed",
        "analyzed_with_fallback_parser",
        "model_only",
        "scanner_supported",
        "deterministic",
        "reproduced",
        "formally_proven"
      ],
      "title": "AnalysisState",
      "type": "string"
    },
    "AuditedSuiteAssertionStatus": {
      "description": "Assertion-strength state; absence of evidence is never called weak.",
      "enum": [
        "not_analyzed",
        "inconclusive",
        "assertion_covered",
        "weak_assertion"
      ],
      "title": "AuditedSuiteAssertionStatus",
      "type": "string"
    },
    "AuditedSuiteCoverage": {
      "additionalProperties": false,
      "description": "Comparison-only source coverage projection from repository-owned tests.",
      "properties": {
        "contract_statement_coverage": {
          "$ref": "#/$defs/CoverageMetric"
        },
        "critical_classification_complete": {
          "title": "Critical Classification Complete",
          "type": "boolean"
        },
        "critical_function_assertion_coverage": {
          "$ref": "#/$defs/CoverageMetric"
        },
        "function_statement_coverage": {
          "$ref": "#/$defs/CoverageMetric"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/AuditedSuiteCoverageGap"
          },
          "maxItems": 100000,
          "title": "Gaps",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Limitations",
          "type": "array"
        },
        "repository_tests_executed": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Repository Tests Executed",
          "type": "integer"
        },
        "repository_tests_failed": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Repository Tests Failed",
          "type": "integer"
        },
        "repository_tests_selected": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Repository Tests Selected",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.1",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "source_classification_complete": {
          "title": "Source Classification Complete",
          "type": "boolean"
        },
        "statement_coverage_authority": {
          "anyOf": [
            {
              "const": "comparison_only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "comparison_only",
          "title": "Statement Coverage Authority"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/AuditedSuiteSurfaceCoverage"
          },
          "maxItems": 100000,
          "title": "Surfaces",
          "type": "array"
        }
      },
      "required": [
        "contract_statement_coverage",
        "function_statement_coverage",
        "critical_function_assertion_coverage",
        "source_classification_complete",
        "critical_classification_complete"
      ],
      "title": "AuditedSuiteCoverage",
      "type": "object"
    },
    "AuditedSuiteCoverageGap": {
      "additionalProperties": false,
      "description": "Exact non-finding coverage gap for one critical audited-source surface.",
      "properties": {
        "assertion_status": {
          "$ref": "#/$defs/AuditedSuiteAssertionStatus"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "entity_kind": {
          "$ref": "#/$defs/SolidityEntityKind"
        },
        "evidence_sha256s": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Evidence Sha256S",
          "type": "array"
        },
        "gap_id": {
          "pattern": "^audited-suite-gap:[0-9a-f]{64}$",
          "title": "Gap Id",
          "type": "string"
        },
        "is_finding": {
          "const": false,
          "default": false,
          "title": "Is Finding",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/AuditedSuiteCoverageGapKind"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": [
        "gap_id",
        "entity_id",
        "entity_kind",
        "location",
        "kind",
        "assertion_status",
        "detail"
      ],
      "title": "AuditedSuiteCoverageGap",
      "type": "object"
    },
    "AuditedSuiteCoverageGapKind": {
      "description": "Non-finding reason a critical audited source surface lacks assertion credit.",
      "enum": [
        "assertion_not_analyzed",
        "assertion_inconclusive",
        "weak_assertion"
      ],
      "title": "AuditedSuiteCoverageGapKind",
      "type": "string"
    },
    "AuditedSuiteMutationEvidence": {
      "additionalProperties": false,
      "description": "Fully joined but unattested mutation result retained on one exact source surface.",
      "properties": {
        "campaign_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Campaign Evidence Sha256",
          "type": "string"
        },
        "evidence_origin": {
          "const": "planned_unattested",
          "default": "planned_unattested",
          "title": "Evidence Origin",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "mutation_id": {
          "pattern": "^mut-[a-z0-9][a-z0-9-]{0,75}$",
          "title": "Mutation Id",
          "type": "string"
        },
        "mutation_specification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mutation Specification Sha256",
          "type": "string"
        },
        "observation_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Sha256"
        },
        "outcome": {
          "$ref": "#/$defs/AuditedSuiteMutationOutcome"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "property_id": {
          "pattern": "^prop-[0-9a-f]{24}$",
          "title": "Property Id",
          "type": "string"
        },
        "source_repository_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Repository Sha256",
          "type": "string"
        },
        "surface_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Surface Binding Sha256",
          "type": "string"
        }
      },
      "required": [
        "property_id",
        "mutation_id",
        "outcome",
        "plan_sha256",
        "source_repository_sha256",
        "mutation_specification_sha256",
        "campaign_evidence_sha256",
        "surface_binding_sha256",
        "evidence_sha256"
      ],
      "title": "AuditedSuiteMutationEvidence",
      "type": "object"
    },
    "AuditedSuiteMutationOutcome": {
      "description": "Typed result of one applicable mutation challenged by the audited suite.",
      "enum": [
        "killed",
        "survived",
        "inconclusive"
      ],
      "title": "AuditedSuiteMutationOutcome",
      "type": "string"
    },
    "AuditedSuiteStatementStatus": {
      "description": "Entity-level statement-coverage state from the audited repository's own suite.",
      "enum": [
        "not_analyzed",
        "inconclusive",
        "covered",
        "uncovered"
      ],
      "title": "AuditedSuiteStatementStatus",
      "type": "string"
    },
    "AuditedSuiteSurfaceCoverage": {
      "additionalProperties": false,
      "description": "Comparison-only projection for one exact indexed audited-source entity.",
      "properties": {
        "assertion_status": {
          "$ref": "#/$defs/AuditedSuiteAssertionStatus"
        },
        "contract_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Contract Name",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "entity_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "entity_kind": {
          "$ref": "#/$defs/SolidityEntityKind"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "mutation_evidence": {
          "items": {
            "$ref": "#/$defs/AuditedSuiteMutationEvidence"
          },
          "maxItems": 10000,
          "title": "Mutation Evidence",
          "type": "array"
        },
        "repository_test_execution_sha256s": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Repository Test Execution Sha256S",
          "type": "array"
        },
        "statement_evidence_sha256s": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Statement Evidence Sha256S",
          "type": "array"
        },
        "statement_status": {
          "$ref": "#/$defs/AuditedSuiteStatementStatus"
        }
      },
      "required": [
        "entity_id",
        "entity_kind",
        "contract_name",
        "location",
        "critical",
        "statement_status",
        "assertion_status"
      ],
      "title": "AuditedSuiteSurfaceCoverage",
      "type": "object"
    },
    "CoverageExclusion": {
      "additionalProperties": false,
      "description": "One explicitly evidenced member removed from a coverage denominator.",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/CoverageProvenance"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "subject": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "reason",
        "provenance"
      ],
      "title": "CoverageExclusion",
      "type": "object"
    },
    "CoverageMetric": {
      "additionalProperties": false,
      "description": "One independently auditable coverage dimension; never a context-free score.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/CoverageExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "not_applicable_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Not Applicable Evidence",
          "type": "array"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "percentage": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage"
        },
        "population": {
          "minimum": 0,
          "title": "Population",
          "type": "integer"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/CoverageProvenance"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/AnalysisState"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "population",
        "exclusions",
        "not_applicable_evidence",
        "confidence",
        "provenance",
        "failures",
        "state",
        "detail"
      ],
      "title": "CoverageMetric",
      "type": "object"
    },
    "CoverageProvenance": {
      "description": "Origin of a coverage count, exclusion, or failure observation.",
      "enum": [
        "discovery",
        "configuration",
        "compiler",
        "symbol_index",
        "semantic_graph",
        "static_tool",
        "model_context",
        "model_review",
        "invariant_execution",
        "formal_engine",
        "runtime"
      ],
      "title": "CoverageProvenance",
      "type": "string"
    },
    "EconomicSimulationKind": {
      "enum": [
        "erc4626_donation_inflation",
        "reward_index_manipulation",
        "flash_loan_oracle_manipulation",
        "oracle_freshness_scale_availability",
        "amm_reserve_manipulation",
        "liquidation_edge_cases",
        "share_price_exchange_rate",
        "fee_on_transfer_rebasing_accounting",
        "rounding_exploitation",
        "governance_timelock_race",
        "upgrade_initializer_misuse",
        "cross_chain_duplicate_ordering",
        "callback_receiver_reentrancy",
        "bounded_state_growth",
        "multi_transaction_state_ordering",
        "sandwich_sensitive_flow",
        "signature_nonce_domain_replay"
      ],
      "title": "EconomicSimulationKind",
      "type": "string"
    },
    "EconomicTemplateExecutionCoverage": {
      "additionalProperties": false,
      "description": "Per-template generated-harness lifecycle evidence.",
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "compiler_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Compiler Sha256S",
          "type": "array"
        },
        "counterexamples": {
          "minimum": 0,
          "title": "Counterexamples",
          "type": "integer"
        },
        "counterexamples_minimized": {
          "minimum": 0,
          "title": "Counterexamples Minimized",
          "type": "integer"
        },
        "execution_required": {
          "title": "Execution Required",
          "type": "boolean"
        },
        "harnesses_compiled": {
          "minimum": 0,
          "title": "Harnesses Compiled",
          "type": "integer"
        },
        "harnesses_executed": {
          "minimum": 0,
          "title": "Harnesses Executed",
          "type": "integer"
        },
        "harnesses_generated": {
          "minimum": 0,
          "title": "Harnesses Generated",
          "type": "integer"
        },
        "harnesses_replayed": {
          "minimum": 0,
          "title": "Harnesses Replayed",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EconomicSimulationKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "source_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Source Sha256S",
          "type": "array"
        },
        "statuses": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/InvariantExecutionStatus"
          },
          "title": "Statuses",
          "type": "object"
        },
        "typed_harness_available": {
          "title": "Typed Harness Available",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "applicable",
        "execution_required",
        "typed_harness_available",
        "harnesses_generated",
        "harnesses_compiled",
        "harnesses_executed",
        "harnesses_replayed",
        "counterexamples",
        "counterexamples_minimized"
      ],
      "title": "EconomicTemplateExecutionCoverage",
      "type": "object"
    },
    "InvariantExecutionStatus": {
      "enum": [
        "not_attempted",
        "generation_failed",
        "environment_blocked",
        "compile_failed",
        "execution_failed",
        "timed_out",
        "passed",
        "counterexample"
      ],
      "title": "InvariantExecutionStatus",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "title": "Location",
      "type": "object"
    },
    "SolidityCoverage": {
      "$comment": "Runtime validation additionally requires one canonical evidence hash per sparse omitted-kind entry and exact candidate = retained-occurrence + omitted arithmetic.",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "graph_candidate_edge_counts": {
                "maxProperties": 27,
                "minProperties": 27
              },
              "graph_edge_counts": {
                "maxProperties": 27,
                "minProperties": 27
              },
              "graph_fact_candidate_counts": {
                "maxProperties": 3,
                "minProperties": 3
              },
              "graph_fact_retained_counts": {
                "maxProperties": 3,
                "minProperties": 3
              },
              "graph_fact_retained_occurrence_counts": {
                "maxProperties": 3,
                "minProperties": 3
              },
              "graph_retained_edge_occurrence_counts": {
                "maxProperties": 27,
                "minProperties": 27
              }
            }
          },
          "if": {
            "properties": {
              "graph_analysis_state": {
                "const": "not_analyzed"
              }
            },
            "required": [
              "graph_analysis_state"
            ]
          },
          "then": {
            "properties": {
              "asset_flow_direction_counts": {
                "maxProperties": 0
              },
              "asset_flow_operation_counts": {
                "maxProperties": 0
              },
              "control_resolution_counts": {
                "maxProperties": 0
              },
              "dependency_resolution_counts": {
                "maxProperties": 0
              },
              "governance_stage_counts": {
                "maxProperties": 0
              },
              "graph_candidate_edge_counts": {
                "maxProperties": 0
              },
              "graph_edge_counts": {
                "maxProperties": 0
              },
              "graph_fact_candidate_counts": {
                "maxProperties": 0
              },
              "graph_fact_omission_evidence_sha256s": {
                "maxItems": 0
              },
              "graph_fact_omitted_counts": {
                "maxProperties": 0
              },
              "graph_fact_retained_counts": {
                "maxProperties": 0
              },
              "graph_fact_retained_occurrence_counts": {
                "maxProperties": 0
              },
              "graph_node_counts": {
                "maxProperties": 0
              },
              "graph_omission_evidence_sha256s": {
                "maxItems": 0
              },
              "graph_omitted_edge_counts": {
                "maxProperties": 0
              },
              "graph_retained_edge_occurrence_counts": {
                "maxProperties": 0
              },
              "graph_warnings": {
                "maxItems": 0
              },
              "oracle_freshness_counts": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "graph_analysis_state": {
                "const": "attempted_but_failed"
              }
            },
            "required": [
              "graph_analysis_state"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "graph_omission_evidence_sha256s": {
                    "minItems": 1
                  },
                  "graph_omitted_edge_counts": {
                    "minProperties": 1
                  }
                }
              },
              {
                "properties": {
                  "graph_fact_omission_evidence_sha256s": {
                    "minItems": 1
                  },
                  "graph_fact_omitted_counts": {
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "graph_analysis_state": {
                "enum": [
                  "analyzed_with_fallback_parser",
                  "deterministic"
                ]
              }
            },
            "required": [
              "graph_analysis_state"
            ]
          },
          "then": {
            "properties": {
              "graph_fact_omission_evidence_sha256s": {
                "maxItems": 0
              },
              "graph_fact_omitted_counts": {
                "maxProperties": 0
              },
              "graph_omission_evidence_sha256s": {
                "maxItems": 0
              },
              "graph_omitted_edge_counts": {
                "maxProperties": 0
              }
            }
          }
        }
      ],
      "properties": {
        "asset_flow_direction_counts": {
          "additionalProperties": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Asset Flow Direction Counts",
          "type": "object"
        },
        "asset_flow_operation_counts": {
          "additionalProperties": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Asset Flow Operation Counts",
          "type": "object"
        },
        "ast_backed_files": {
          "default": 0,
          "title": "Ast Backed Files",
          "type": "integer"
        },
        "audited_suite_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditedSuiteCoverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Context Limitations",
          "type": "array"
        },
        "contracts_failed_compilation": {
          "items": {
            "type": "string"
          },
          "title": "Contracts Failed Compilation",
          "type": "array"
        },
        "contracts_indexed": {
          "default": 0,
          "title": "Contracts Indexed",
          "type": "integer"
        },
        "control_resolution_counts": {
          "additionalProperties": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Control Resolution Counts",
          "type": "object"
        },
        "dependency_resolution_counts": {
          "additionalProperties": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Dependency Resolution Counts",
          "type": "object"
        },
        "economic_simulations_executed": {
          "default": 0,
          "title": "Economic Simulations Executed",
          "type": "integer"
        },
        "economic_simulations_planned": {
          "default": 0,
          "title": "Economic Simulations Planned",
          "type": "integer"
        },
        "economic_template_execution": {
          "additionalProperties": {
            "$ref": "#/$defs/EconomicTemplateExecutionCoverage"
          },
          "propertyNames": {
            "$ref": "#/$defs/EconomicSimulationKind"
          },
          "title": "Economic Template Execution",
