{
  "$comment": "Runtime reconstructs per-property and per-class arithmetic and requires every gate. Missing classes cannot pass. Neither serialization nor local comparison grants admitted campaign, benchmark, qualification or release authority.",
  "$defs": {
    "MutationClassScore": {
      "additionalProperties": false,
      "description": "Keep every required class and each of its property gates visible.",
      "properties": {
        "gate_passed": {
          "title": "Gate Passed",
          "type": "boolean"
        },
        "mutation_class": {
          "$ref": "#/$defs/SecurityMutationClass"
        },
        "property_scores": {
          "items": {
            "$ref": "#/$defs/PropertyMutationScore"
          },
          "maxItems": 10000,
          "title": "Property Scores",
          "type": "array"
        }
      },
      "required": [
        "mutation_class",
        "property_scores",
        "gate_passed"
      ],
      "title": "MutationClassScore",
      "type": "object"
    },
    "MutationKind": {
      "description": "Implemented source-local classes used to challenge defensive properties.",
      "enum": [
        "access_control_guard_removal",
        "replay_state_update_removal",
        "boundary_check_weakening",
        "accounting_operator_replacement",
        "external_call_result_check_removal"
      ],
      "title": "MutationKind",
      "type": "string"
    },
    "MutationPropertyOutcome": {
      "additionalProperties": false,
      "description": "Hash-linked outcome for one property/mutation pair.",
      "properties": {
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "mutation_id": {
          "pattern": "^mut-[a-z0-9][a-z0-9-]{0,75}$",
          "title": "Mutation Id",
          "type": "string"
        },
        "mutation_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationKind"
            },
            {
              "$ref": "#/$defs/SecurityMutationClass"
            }
          ],
          "title": "Mutation Kind"
        },
        "outcome": {
          "$ref": "#/$defs/MutationTestOutcome"
        },
        "property_id": {
          "pattern": "^prop-[0-9a-f]{24}$",
          "title": "Property Id",
          "type": "string"
        }
      },
      "required": [
        "mutation_id",
        "mutation_kind",
        "property_id",
        "outcome",
        "evidence_sha256"
      ],
      "title": "MutationPropertyOutcome",
      "type": "object"
    },
    "MutationScorecardEvidenceOrigin": {
      "description": "Trust origin of mutation outcomes; process origin still needs a live opaque seal.",
      "enum": [
        "declarative",
        "planned_unattested",
        "process_local_comparison"
      ],
      "title": "MutationScorecardEvidenceOrigin",
      "type": "string"
    },
    "MutationTestOutcome": {
      "description": "Normalized result of challenging one property with one applicable mutation.",
      "enum": [
        "killed",
        "survived",
        "inconclusive"
      ],
      "title": "MutationTestOutcome",
      "type": "string"
    },
    "PropertyMutationScore": {
      "additionalProperties": false,
      "description": "Explicit kill score for one expected invariant/property.",
      "properties": {
        "applicable_mutations": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Applicable Mutations",
          "type": "integer"
        },
        "gate_passed": {
          "title": "Gate Passed",
          "type": "boolean"
        },
        "inconclusive": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        },
        "kill_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kill Score"
        },
        "killed": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Killed",
          "type": "integer"
        },
        "minimum_required": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Required",
          "type": "number"
        },
        "property_id": {
          "pattern": "^prop-[0-9a-f]{24}$",
          "title": "Property Id",
          "type": "string"
        },
        "survived": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Survived",
          "type": "integer"
        }
      },
      "required": [
        "property_id",
        "applicable_mutations",
        "killed",
        "survived",
        "inconclusive",
        "minimum_required",
        "gate_passed"
      ],
      "title": "PropertyMutationScore",
      "type": "object"
    },
    "SecurityMutationClass": {
      "description": "The eleven explicit requirements, distinct from legacy generic operators.",
      "enum": [
        "removed_authorization",
        "removed_nonce_update",
        "changed_rounding_direction",
        "removed_stale_price_validation",
        "external_call_before_state_update",
        "removed_initializer_protection",
        "weakened_timelock",
        "changed_storage_slot",
        "removed_pause_enforcement",
        "unchecked_return_handling",
        "incorrect_decimal_scale"
      ],
      "title": "SecurityMutationClass",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/mutation_scorecard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "class_scores": {
            "type": "null"
          },
          "portfolio_scope": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "applicability_plan_sha256": {
            "type": "string"
          },
          "class_scores": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "changed_rounding_direction"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "changed_storage_slot"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "external_call_before_state_update"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "incorrect_decimal_scale"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "removed_authorization"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "removed_initializer_protection"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "removed_nonce_update"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "removed_pause_enforcement"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "removed_stale_price_validation"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "unchecked_return_handling"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "mutation_class": {
                      "const": "weakened_timelock"
                    }
                  },
                  "required": [
                    "mutation_class"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              }
            ],
            "maxItems": 11,
            "minItems": 11,
            "type": "array"
          },
          "evidence_origin": {
            "enum": [
              "planned_unattested",
              "process_local_comparison"
            ]
          },
          "portfolio_scope": {
            "const": "required_eleven_class"
          }
        },
        "required": [
          "portfolio_scope",
          "class_scores",
          "applicability_plan_sha256"
        ]
      }
    }
  ],
  "description": "Per-property mutation quality evidence; aggregate scores cannot hide weak properties.",
  "properties": {
    "applicability_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability Plan Sha256"
    },
    "class_scores": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MutationClassScore"
          },
          "maxItems": 11,
          "minItems": 11,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Class Scores"
    },
    "evidence_origin": {
      "$ref": "#/$defs/MutationScorecardEvidenceOrigin",
      "default": "declarative"
    },
    "expected_property_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Expected Property Ids",
      "type": "array"
    },
    "gate_passed": {
      "title": "Gate Passed",
      "type": "boolean"
    },
    "minimum_property_kill_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Property Kill Score",
      "type": "number"
    },
    "mutation_count": {
      "maximum": 100000,
      "minimum": 0,
      "title": "Mutation Count",
      "type": "integer"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/MutationPropertyOutcome"
      },
      "maxItems": 100000,
      "title": "Outcomes",
      "type": "array"
    },
    "overall_kill_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overall Kill Score"
    },
    "portfolio_scope": {
      "anyOf": [
        {
          "const": "required_eleven_class",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Portfolio Scope"
    },
    "projection_authority": {
      "anyOf": [
        {
          "const": "comparison_only",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection Authority"
    },
    "property_corpus_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Property Corpus Hash",
      "type": "string"
    },
    "property_repositories": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 10000,
      "minProperties": 1,
      "title": "Property Repositories",
      "type": "object"
    },
    "property_scores": {
      "items": {
        "$ref": "#/$defs/PropertyMutationScore"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Property Scores",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1",
        "2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "property_corpus_hash",
    "minimum_property_kill_score",
    "expected_property_ids",
    "property_repositories",
    "mutation_count",
    "property_scores",
    "gate_passed"
  ],
  "title": "MutationScorecard",
  "type": "object"
}
