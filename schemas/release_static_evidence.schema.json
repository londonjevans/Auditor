{
  "$defs": {
    "ManifestFileBinding": {
      "additionalProperties": false,
      "description": "Hash and size for one normalized source or run-artifact path.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ManifestFileBinding",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/release_static_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed static release validation evidence.",
  "properties": {
    "adversarial_cases": {
      "minimum": 1,
      "title": "Adversarial Cases",
      "type": "integer"
    },
    "adversarial_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adversarial Manifest Sha256",
      "type": "string"
    },
    "benchmark_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Evidence Sha256",
      "type": "string"
    },
    "benchmark_source_bindings": {
      "minimum": 1,
      "title": "Benchmark Source Bindings",
      "type": "integer"
    },
    "candidate_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_observation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Observation Sha256",
      "type": "string"
    },
    "economic_cases": {
      "minimum": 1,
      "title": "Economic Cases",
      "type": "integer"
    },
    "economic_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Economic Manifest Sha256",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "foundry_ast_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Foundry Ast Sha256",
      "type": "string"
    },
    "full_protocol_files": {
      "minimum": 1,
      "title": "Full Protocol Files",
      "type": "integer"
    },
    "full_protocol_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Full Protocol Manifest Sha256",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "model_cases": {
      "minimum": 1,
      "title": "Model Cases",
      "type": "integer"
    },
    "model_corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Corpus Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Schema Inventory Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "schemas": {
      "items": {
        "$ref": "#/$defs/ManifestFileBinding"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Schemas",
      "type": "array"
    },
    "snapshot_comparison_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Comparison Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "candidate_commit",
    "candidate_observation_sha256",
    "observed_at",
    "schemas",
    "schema_inventory_sha256",
    "benchmark_source_bindings",
    "benchmark_evidence_sha256",
    "model_cases",
    "model_corpus_sha256",
    "economic_cases",
    "economic_manifest_sha256",
    "adversarial_cases",
    "adversarial_manifest_sha256",
    "full_protocol_files",
    "full_protocol_manifest_sha256",
    "snapshot_comparison_sha256",
    "foundry_ast_sha256",
    "evidence_sha256"
  ],
  "title": "StaticReleaseEvidence",
  "type": "object"
}
