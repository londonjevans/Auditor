{
  "$defs": {
    "AuthenticatedRunnerSelection": {
      "additionalProperties": false,
      "description": "Planning-only three-model role assignment; independence is not asserted.",
      "properties": {
        "candidate_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Candidate Model Id",
          "type": "string"
        },
        "distinct_root_lineages_verified": {
          "const": false,
          "title": "Distinct Root Lineages Verified",
          "type": "boolean"
        },
        "primary_judge_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Primary Judge Model Id",
          "type": "string"
        },
        "replay_judge_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Replay Judge Model Id",
          "type": "string"
        },
        "required_completion_limit_source": {
          "const": "metadata",
          "title": "Required Completion Limit Source",
          "type": "string"
        },
        "required_output_mode": {
          "const": "NATIVE_JSON_SCHEMA",
          "title": "Required Output Mode",
          "type": "string"
        },
        "required_reasoning_effort": {
          "const": "high",
          "title": "Required Reasoning Effort",
          "type": "string"
        },
        "required_supported_parameters": {
          "items": {
            "const": "structured_outputs",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Required Supported Parameters",
          "type": "array"
        },
        "role_assignment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Role Assignment Sha256",
          "type": "string"
        },
        "route_constraints": {
          "items": {
            "$ref": "#/$defs/ExactRouteConstraint"
          },
          "maxItems": 18,
          "minItems": 3,
          "title": "Route Constraints",
          "type": "array"
        },
        "route_predicate_profile": {
          "$ref": "#/$defs/RoutePredicateProfile"
        }
      },
      "required": [
        "candidate_model_id",
        "primary_judge_model_id",
        "replay_judge_model_id",
        "required_output_mode",
        "required_supported_parameters",
        "required_reasoning_effort",
        "required_completion_limit_source",
        "route_predicate_profile",
        "route_constraints",
        "distinct_root_lineages_verified",
        "role_assignment_sha256"
      ],
      "title": "AuthenticatedRunnerSelection",
      "type": "object"
    },
    "CandidateSelectionEndpointInventoryRefresh": {
      "additionalProperties": false,
      "description": "One explicit, nonauthorizing endpoint inventory transition.",
      "properties": {
        "constrained_discovery_required": {
          "const": true,
          "title": "Constrained Discovery Required",
          "type": "boolean"
        },
        "discovery_evidence_embedded": {
          "const": false,
          "title": "Discovery Evidence Embedded",
          "type": "boolean"
        },
        "disposition": {
          "const": "OPERATOR_STAGED_UNVERIFIED",
          "title": "Disposition",
          "type": "string"
        },
        "endpoint_authority": {
          "const": false,
          "title": "Endpoint Authority",
          "type": "boolean"
        },
        "exact_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Exact Model Id",
          "type": "string"
        },
        "predecessor_allowed_provider_endpoints": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Predecessor Allowed Provider Endpoints",
          "type": "array"
        },
        "predecessor_entry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Predecessor Entry Sha256",
          "type": "string"
        },
        "provider_endpoint": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_metadata_embedded": {
          "const": false,
          "title": "Provider Metadata Embedded",
          "type": "boolean"
        },
        "refresh_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Refresh Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "exact_model_id",
        "predecessor_entry_sha256",
        "predecessor_allowed_provider_endpoints",
        "provider_endpoint",
        "disposition",
        "constrained_discovery_required",
        "provider_metadata_embedded",
        "discovery_evidence_embedded",
        "endpoint_authority",
        "refresh_sha256"
      ],
      "title": "CandidateSelectionEndpointInventoryRefresh",
      "type": "object"
    },
    "CandidateSelectionEntry": {
      "additionalProperties": false,
      "description": "One exact candidate proposal with no discovery or lineage authority.",
      "properties": {
        "advisory_lineage_group": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/+-]{0,199}$",
          "title": "Advisory Lineage Group",
          "type": "string"
        },
        "allowed_provider_endpoints": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Allowed Provider Endpoints",
          "type": "array"
        },
        "approved_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Approved Roles",
          "type": "array"
        },
        "availability": {
          "const": "UNVERIFIED",
          "title": "Availability",
          "type": "string"
        },
        "documentary_lineage": {
          "const": "UNCONFIRMED",
          "title": "Documentary Lineage",
          "type": "string"
        },
        "entry_authority": {
          "const": false,
          "title": "Entry Authority",
          "type": "boolean"
        },
        "entry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Sha256",
          "type": "string"
        },
        "exact_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Exact Model Id",
          "type": "string"
        },
        "lineage_group_seed_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lineage Group Seed Sha256",
          "type": "string"
        },
        "priority_rank": {
          "maximum": 128,
          "minimum": 1,
          "title": "Priority Rank",
          "type": "integer"
        }
      },
      "required": [
        "exact_model_id",
        "priority_rank",
        "advisory_lineage_group",
        "lineage_group_seed_sha256",
        "allowed_provider_endpoints",
        "approved_roles",
        "availability",
        "documentary_lineage",
        "entry_authority",
        "entry_sha256"
      ],
      "title": "CandidateSelectionEntry",
      "type": "object"
    },
    "CandidateSelectionSourceBinding": {
      "additionalProperties": false,
      "description": "Exact bytes for one operator-staged, explicitly unverified input.",
      "properties": {
        "authenticity": {
          "const": "OPERATOR_STAGED_UNVERIFIED",
          "title": "Authenticity",
          "type": "string"
        },
        "byte_count": {
          "maximum": 2000000,
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "filename": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "title": "Filename",
          "type": "string"
        },
        "kind": {
          "enum": [
            "MODEL_RANKING_IMPLEMENTATION",
            "OPERATOR_LINEAGE_REVIEW"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Binding Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "filename",
        "byte_count",
        "content_sha256",
        "authenticity",
        "source_binding_sha256"
      ],
      "title": "CandidateSelectionSourceBinding",
      "type": "object"
    },
    "ExactRouteConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Constraint Sha256",
          "type": "string"
        },
        "exact_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Exact Model Id",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "provider_endpoint": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Provider Endpoint",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExactRouteRole"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "exact_model_id",
        "provider_endpoint",
        "profile_sha256",
        "constraint_sha256"
      ],
      "title": "ExactRouteConstraint",
      "type": "object"
    },
    "ExactRouteRole": {
      "enum": [
        "candidate",
        "primary_judge",
        "replay_judge"
      ],
      "title": "ExactRouteRole",
      "type": "string"
    },
    "ProviderPriceCapAlgorithm": {
      "enum": [
        "MMAUDIT_OPENROUTER_MAX_PRICE_CEILING_V1"
      ],
      "title": "ProviderPriceCapAlgorithm",
      "type": "string"
    },
    "RoutePredicateDisposition": {
      "enum": [
        "SATISFIED",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "RoutePredicateDisposition",
      "type": "string"
    },
    "RoutePredicateId": {
      "description": "The complete, ordered route-admission predicate inventory.",
      "enum": [
        "EXACT_MODEL_IDENTITY",
        "EXACT_PROVIDER_ENDPOINT",
        "PROVIDER_DISPLAY_NAME_INJECTIVITY",
        "OPERATIONAL_STATUS",
        "ZDR_ELIGIBILITY",
        "EMITS_MAX_TOKENS",
        "EMITS_TEMPERATURE",
        "EMITS_RESPONSE_FORMAT",
        "EMITS_REASONING",
        "MODEL_STRUCTURED_OUTPUT_MARKER",
        "ENDPOINT_STRUCTURED_OUTPUT_MARKER",
        "NATIVE_STRUCTURED_OUTPUT_MODE",
        "SINGLETON_EXACT_ROUTE",
        "AUTOMATIC_FALLBACK_DISABLED",
        "REASONING_POLICY_BINDING",
        "REASONING_CONTROL_BINDING",
        "REASONING_CONTROL_VALUES",
        "REASONING_EFFORT_SUPPORT",
        "PROMPT_CAPACITY_ENVELOPE",
        "OUTPUT_CAPACITY_ENVELOPE",
        "CONTEXT_CAPACITY_ENVELOPE",
        "METADATA_COMPLETION_CAPACITY",
        "PRICE_CAP_EXPRESSIBILITY",
        "PRICE_CAP_NO_WEAKER",
        "FROZEN_LIVE_EQUIVALENCE",
        "REGISTRY_SELECTION_HASH_CUSTODY",
        "REGISTRY_CONSTRAINT_HASH_CUSTODY",
        "EMPIRICAL_SCHEMA_CONFORMANCE",
        "TOKEN_DETAIL_REPORTING_CONVENTION"
      ],
      "title": "RoutePredicateId",
      "type": "string"
    },
    "RoutePredicateProfile": {
      "additionalProperties": false,
      "description": "Shared requirements for every exact AUTHRUNNER route.",
      "properties": {
        "accepted_operational_status": {
          "const": "0",
          "title": "Accepted Operational Status",
          "type": "string"
        },
        "allow_automatic_fallbacks": {
          "const": false,
          "title": "Allow Automatic Fallbacks",
          "type": "boolean"
        },
        "emitted_request_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Emitted Request Parameters",
          "type": "array"
        },
        "empirical_schema_conformance_disposition": {
          "$ref": "#/$defs/RoutePredicateDisposition"
        },
        "minimum_context_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Minimum Context Tokens",
          "type": "integer"
        },
        "minimum_prompt_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Minimum Prompt Tokens",
          "type": "integer"
        },
        "native_capability_marker": {
          "const": "structured_outputs",
          "title": "Native Capability Marker",
          "type": "string"
        },
        "predicate_ids": {
          "items": {
            "$ref": "#/$defs/RoutePredicateId"
          },
          "maxItems": 29,
          "minItems": 29,
          "title": "Predicate Ids",
          "type": "array"
        },
        "price_cap_algorithm": {
          "$ref": "#/$defs/ProviderPriceCapAlgorithm"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "reasoning_control_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Control Profile Sha256",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Effort"
        },
        "reasoning_exclude": {
          "title": "Reasoning Exclude",
          "type": "boolean"
        },
        "reasoning_max_tokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Max Tokens"
        },
        "reasoning_mode": {
          "enum": [
            "disabled",
            "default",
            "effort",
            "max_tokens"
          ],
          "title": "Reasoning Mode",
          "type": "string"
        },
        "reasoning_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Policy Sha256",
          "type": "string"
        },
        "reasoning_role_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Role Binding Sha256",
          "type": "string"
        },
        "reasoning_role_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Role Profile Sha256",
          "type": "string"
        },
        "require_singleton_route": {
          "const": true,
          "title": "Require Singleton Route",
          "type": "boolean"
        },
        "require_zdr": {
          "const": true,
          "title": "Require Zdr",
          "type": "boolean"
        },
        "required_completion_limit_source": {
          "const": "metadata",
          "title": "Required Completion Limit Source",
          "type": "string"
        },
        "required_completion_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 131072,
          "title": "Required Completion Tokens",
          "type": "integer"
        },
        "required_output_mode": {
          "const": "NATIVE_JSON_SCHEMA",
          "title": "Required Output Mode",
          "type": "string"
        },
        "required_output_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Required Output Tokens",
          "type": "integer"
        },
        "reserved_reasoning_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Reserved Reasoning Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "token_detail_convention_disposition": {
          "$ref": "#/$defs/RoutePredicateDisposition"
        }
      },
      "required": [
        "predicate_ids",
        "emitted_request_parameters",
        "native_capability_marker",
        "required_output_mode",
        "accepted_operational_status",
        "require_zdr",
        "require_singleton_route",
        "allow_automatic_fallbacks",
        "reasoning_policy_sha256",
        "reasoning_role_profile_sha256",
        "reasoning_role_binding_sha256",
        "reasoning_control_profile_sha256",
        "reasoning_mode",
        "reasoning_effort",
        "reasoning_exclude",
        "reserved_reasoning_tokens",
        "minimum_prompt_tokens",
        "required_output_tokens",
        "required_completion_tokens",
        "minimum_context_tokens",
        "required_completion_limit_source",
        "price_cap_algorithm",
        "empirical_schema_conformance_disposition",
        "token_detail_convention_disposition",
        "profile_sha256"
      ],
      "title": "RoutePredicateProfile",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/candidate_selection_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "predecessor_plan_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "predecessor_plan_sha256"
        ]
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.4"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "required": [
            "predecessor_plan_sha256"
          ]
        }
      }
    },
    {
      "else": {
        "not": {
          "required": [
            "endpoint_inventory_refresh"
          ]
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.6"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "endpoint_inventory_refresh": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "endpoint_inventory_refresh"
        ]
      }
    }
  ],
  "description": "Self-hashed operator-staged seed with only literal-false authority flags.",
  "properties": {
    "artifact_kind": {
      "const": "OPERATOR_STAGED_MODEL_SELECTION",
      "title": "Artifact Kind",
      "type": "string"
    },
    "authenticated_runner_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthenticatedRunnerSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "benchmark_authorized": {
      "const": false,
      "title": "Benchmark Authorized",
      "type": "boolean"
    },
    "cached_ranking_payload_present": {
      "const": false,
      "title": "Cached Ranking Payload Present",
      "type": "boolean"
    },
    "discovery_evidence_present": {
      "const": false,
      "title": "Discovery Evidence Present",
      "type": "boolean"
    },
    "documentary_lineage_identity_authorized": {
      "const": false,
      "title": "Documentary Lineage Identity Authorized",
      "type": "boolean"
    },
    "endpoint_inventory_refresh": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateSelectionEndpointInventoryRefresh"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CandidateSelectionEntry"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "objective_sha256": {
      "const": "e3b895de9c7f5c7836dd7b77c09ae2a31adefa9469d46588ee6f52b78caa0d15",
      "title": "Objective Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "predecessor_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Plan Sha256"
    },
    "production_selection_authorized": {
      "const": false,
      "title": "Production Selection Authorized",
      "type": "boolean"
    },
    "provider_call_authorized": {
      "const": false,
      "title": "Provider Call Authorized",
      "type": "boolean"
    },
    "provider_metadata_present": {
      "const": false,
      "title": "Provider Metadata Present",
      "type": "boolean"
    },
    "qualification_authorized": {
      "const": false,
      "title": "Qualification Authorized",
      "type": "boolean"
    },
    "ranking_executed": {
      "const": false,
      "title": "Ranking Executed",
      "type": "boolean"
    },
    "release_authorized": {
      "const": false,
      "title": "Release Authorized",
      "type": "boolean"
    },
    "runner_authority_authorized": {
      "const": false,
      "title": "Runner Authority Authorized",
      "type": "boolean"
    },
    "schema_version": {
      "enum": [
        "1.4",
        "1.5",
        "1.6"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "seal_publication_authorized": {
      "const": false,
      "title": "Seal Publication Authorized",
      "type": "boolean"
    },
    "serialized_authority": {
      "const": false,
      "title": "Serialized Authority",
      "type": "boolean"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/CandidateSelectionSourceBinding"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Source Bindings",
      "type": "array"
    },
    "source_egress_authorized": {
      "const": false,
      "title": "Source Egress Authorized",
      "type": "boolean"
    },
    "status": {
      "const": "NONAUTHORIZING",
      "title": "Status",
      "type": "string"
    },
    "unresolved_requirements": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Unresolved Requirements",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "objective_sha256",
    "source_bindings",
    "entries",
    "unresolved_requirements",
    "ranking_executed",
    "cached_ranking_payload_present",
    "provider_metadata_present",
    "discovery_evidence_present",
    "documentary_lineage_identity_authorized",
    "provider_call_authorized",
    "source_egress_authorized",
