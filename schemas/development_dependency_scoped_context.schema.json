        },
        "shortfall": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shortfall"
        },
        "source": {
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.sol$",
          "title": "Source",
          "type": "string"
        },
        "spelling": {
