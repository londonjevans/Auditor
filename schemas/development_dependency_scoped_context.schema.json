        "member_resolution": {
          "enum": [
            "DECLARATIONS_BOUND",
            "NOT_ESTABLISHED"
          ],
          "title": "Member Resolution",
          "type": "string"
        },
        "receiver": {
          "$ref": "#/$defs/DependencyTypeBinding"
        },
        "receiver_form": {
          "enum": [
            "VALUE",
            "TYPE_CAST",
            "TYPE_MEMBER",
            "THIS",
            "UNSUPPORTED"
          ],
          "title": "Receiver Form",
          "type": "string"
        },
        "receiver_value_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Receiver Value Ids",
          "type": "array"
        },
        "scope_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Id"
        },
        "shortfalls": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Shortfalls",
          "type": "array"
        },
        "source": {
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.sol$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "byte_start",
        "byte_end",
        "scope_id",
        "member",
        "argument_count",
        "receiver_form",
        "receiver",
        "receiver_value_ids",
        "member_declaration_ids",
        "implementation_ids",
        "implementation_member_ids",
        "shortfalls",
        "member_resolution"
      ],
      "title": "DependencyScopedCall",
      "type": "object"
    },
    "DependencyScopedMembers": {
      "additionalProperties": false,
      "properties": {
        "gap_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4096,
