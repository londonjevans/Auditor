          "type": "array"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "primary": {
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.sol$",
          "title": "Primary",
          "type": "string"
        },
        "unresolved_call_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4096,
