  "$id": "https://mmaudit.local/schemas/development_dependency_scoped_context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calls": {
      "items": {
        "$ref": "#/$defs/DependencyScopedCall"
      },
      "maxItems": 4096,
      "title": "Calls",
      "type": "array"
    },
    "complete_static_resolution": {
      "const": false,
      "default": false,
      "title": "Complete Static Resolution",
      "type": "boolean"
    },
    "functions": {
      "items": {
        "$ref": "#/$defs/DependencyFunctionDeclaration"
      },
      "maxItems": 4096,
      "title": "Functions",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/DependencyTargetGap"
      },
      "maxItems": 4096,
      "title": "Gaps",
      "type": "array"
    },
    "policy": {
      "default": "MODERN_LEXICAL_VALUES_AND_NOMINAL_MEMBERS_V1",
      "enum": [
        "MODERN_LEXICAL_VALUES_AND_NOMINAL_MEMBERS_V1",
        "MODERN_LEXICAL_VALUES_AND_MODIFIER_HEADERS_V2",
        "MODERN_LEXICAL_VALUES_AND_CONSTRUCTOR_HEADERS_V3"
      ],
      "title": "Policy",
      "type": "string"
    },
    "primaries": {
      "items": {
        "$ref": "#/$defs/DependencyScopedMembers"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Primaries",
      "type": "array"
    },
    "scope": {
      "const": "SOURCE_DECLARATIONS_NOT_COMPLETE_TYPECHECK_OR_DEPLOYED_DISPATCH",
      "default": "SOURCE_DECLARATIONS_NOT_COMPLETE_TYPECHECK_OR_DEPLOYED_DISPATCH",
      "title": "Scope",
      "type": "string"
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/DependencyLexicalScope"
      },
      "maxItems": 4096,
      "title": "Scopes",
      "type": "array"
    },
    "source_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Inventory Sha256",
      "type": "string"
    },
    "supplied_type_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Supplied Type Ids",
      "type": "array"
    },
    "target_context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Context Sha256",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/DependencyValueDeclaration"
      },
      "maxItems": 4096,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "source_inventory_sha256",
    "target_context_sha256",
    "supplied_type_ids",
    "scopes",
    "values",
    "functions",
    "calls",
    "gaps",
    "primaries"
  ],
  "title": "DependencyScopedContext",
  "type": "object"
}
