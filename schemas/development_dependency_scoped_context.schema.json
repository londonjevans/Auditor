{
  "$defs": {
    "DependencyFunctionDeclaration": {
      "additionalProperties": false,
      "properties": {
        "body_byte_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 262144,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Byte End"
        },
        "body_byte_start": {
          "anyOf": [
            {
              "exclusiveMaximum": 262144,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Byte Start"
        },
        "byte_end": {
          "exclusiveMinimum": 0,
          "maximum": 262144,
          "title": "Byte End",
          "type": "integer"
        },
        "byte_start": {
          "exclusiveMaximum": 262144,
          "minimum": 0,
          "title": "Byte Start",
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "constructor",
            "modifier",
            "fallback",
            "receive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "title": "Name",
          "type": "string"
        },
        "owner_type_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Owner Type Id",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/DependencyTypeBinding"
          },
          "maxItems": 64,
          "title": "Parameters",
          "type": "array"
        },
        "returns": {
          "items": {
            "$ref": "#/$defs/DependencyTypeBinding"
          },
          "maxItems": 64,
          "title": "Returns",
          "type": "array"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.sol$",
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "external",
            "private",
            "internal",
            "UNSPECIFIED"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "source_sha256",
        "owner_type_id",
        "byte_start",
        "byte_end",
        "scope_id",
        "kind",
        "name",
        "parameters",
        "returns",
        "visibility",
        "body_byte_start",
        "body_byte_end"
      ],
      "title": "DependencyFunctionDeclaration",
      "type": "object"
    },
    "DependencyLexicalScope": {
      "additionalProperties": false,
      "properties": {
        "byte_end": {
          "exclusiveMinimum": 0,
