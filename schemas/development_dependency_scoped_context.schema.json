          "title": "Byte End",
          "type": "integer"
        },
        "byte_start": {
          "exclusiveMaximum": 262144,
          "minimum": 0,
          "title": "Byte Start",
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CONTRACT",
            "FUNCTION",
            "BLOCK",
            "FOR"
          ],
          "title": "Kind",
          "type": "string"
        },
        "owner_type_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Owner Type Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "source": {
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.sol$",
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "source_sha256",
        "owner_type_id",
        "byte_start",
        "byte_end",
        "kind",
        "parent_id"
      ],
      "title": "DependencyLexicalScope",
      "type": "object"
    },
    "DependencyScopedCall": {
      "additionalProperties": false,
      "properties": {
        "argument_count": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
