{
  "$defs": {
    "ActorAssessmentDisposition": {
      "enum": [
        "current_role",
        "not_applicable_nonprivileged",
        "ordinary_legitimate_behavior",
        "aligned_action_justified",
        "aligned_action_unjustified",
        "admitted_role_unfilled",
        "role_unmodeled",
        "context_unverified",
        "finding_actor_unstated",
        "actor_model_missing",
        "actor_model_invalid",
        "actor_model_future",
        "actor_model_stale"
      ],
      "title": "ActorAssessmentDisposition",
      "type": "string"
    },
    "ActorEconomicExposureKind": {
      "enum": [
        "fee_revenue",
        "protocol_failure_loss"
      ],
      "title": "ActorEconomicExposureKind",
      "type": "string"
    },
    "ActorExposureState": {
      "enum": [
        "present",
        "none",
        "unknown"
      ],
      "title": "ActorExposureState",
      "type": "string"
    },
    "ActorFindingBaseline": {
      "additionalProperties": false,
      "description": "Exact pre-calibration finding retained before actor evidence changes severity.",
      "properties": {
        "finding": {
          "$ref": "#/$defs/Finding"
        },
        "finding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finding Sha256",
          "type": "string"
        }
      },
      "required": [
        "finding",
        "finding_sha256"
      ],
      "title": "ActorFindingBaseline",
      "type": "object"
    },
    "ActorHarmedPartyDisposition": {
      "enum": [
        "identified",
        "not_applicable",
        "unresolved"
      ],
      "title": "ActorHarmedPartyDisposition",
      "type": "string"
    },
    "ActorLikelihoodAdjustment": {
      "enum": [
        "increased",
        "decreased",
        "unchanged",
        "unassessed"
      ],
      "title": "ActorLikelihoodAdjustment",
      "type": "string"
    },
    "ActorModelApplicability": {
      "description": "Whether a finding's mechanism depends on privileged actor conduct.",
      "enum": [
        "privileged_actor_required",
        "no_privileged_actor_required",
        "unstated"
      ],
      "title": "ActorModelApplicability",
      "type": "string"
    },
    "ActorModelInputState": {
      "enum": [
        "current",
        "missing",
        "invalid",
        "future",
        "stale"
      ],
      "title": "ActorModelInputState",
      "type": "string"
    },
    "ActorRemediationFocus": {
      "description": "Host-derived remediation framing produced from the actor disposition.",
      "enum": [
        "reachable_state_transition",
        "legitimate_state_transition",
        "role_activation_control",
        "economic_plausibility",
        "actor_context_verification"
      ],
      "title": "ActorRemediationFocus",
      "type": "string"
    },
    "ActorRoleOccupancy": {
      "enum": [
        "currently_held",
        "admitted_unfilled"
      ],
      "title": "ActorRoleOccupancy",
      "type": "string"
    },
    "ActorSeverity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "ActorSeverity",
      "type": "string"
    },
    "CandidateActorContext": {
      "additionalProperties": false,
      "description": "One finding's explicit actor assumptions; never an assertion of role ownership.",
      "properties": {
        "action_against_stated_interest": {
          "title": "Action Against Stated Interest",
          "type": "boolean"
        },
        "harmed_party_disposition": {
          "$ref": "#/$defs/ActorHarmedPartyDisposition"
        },
        "harmed_party_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harmed Party Id"
        },
        "misconduct_required": {
          "title": "Misconduct Required",
          "type": "boolean"
        },
        "ordinary_legitimate_behavior": {
          "title": "Ordinary Legitimate Behavior",
          "type": "boolean"
        },
        "permission": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission"
        },
        "plausibility_evidence_reference_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Plausibility Evidence Reference Ids",
          "type": "array"
        },
        "plausibility_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plausibility Rationale"
        },
        "privileged_action_required": {
          "title": "Privileged Action Required",
          "type": "boolean"
        },
        "relevant_constraint_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Relevant Constraint Ids",
          "type": "array"
        },
        "relevant_economic_exposures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorEconomicExposureKind"
          },
          "maxItems": 2,
          "title": "Relevant Economic Exposures",
          "type": "array"
        },
        "required_concentrated_role_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Concentrated Role Ids",
          "type": "array"
        },
        "role_id": {
          "pattern": "^[a-z][a-z0-9._:-]{0,159}$",
          "title": "Role Id",
          "type": "string"
        },
        "severity_basis": {
          "const": "code_mechanism_only",
          "title": "Severity Basis",
          "type": "string"
        },
        "stated_interest": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stated Interest"
        }
      },
      "required": [
        "role_id",
        "severity_basis",
        "harmed_party_disposition",
        "privileged_action_required",
        "misconduct_required",
        "ordinary_legitimate_behavior",
        "action_against_stated_interest"
      ],
      "title": "CandidateActorContext",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "type": {
          "enum": [
            "model",
            "scanner",
            "execution",
            "reproduction",
            "formal",
            "repository"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceStrength": {
      "enum": [
        "none",
        "model_inference",
        "independent_model_support",
        "validated_attack_path",
        "deterministic_analyzer",
        "deterministic_execution_counterexample",
        "local_fork_reproduction",
        "minimized_local_fork_reproduction",
        "formal_counterexample"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "actor_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingActorAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actor_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateActorContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actor_model_applicability": {
          "$ref": "#/$defs/ActorModelApplicability",
          "default": "unstated"
        },
        "attack_path": {
          "items": {
            "type": "string"
          },
          "title": "Attack Path",
          "type": "array"
        },
        "compensating_controls": {
          "items": {
            "type": "string"
          },
          "title": "Compensating Controls",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "contributing_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contributing Candidate Ids",
          "type": "array"
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "disagreement": {
          "default": "",
          "title": "Disagreement",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength",
          "default": "none"
        },
        "execution_provenance": {
          "items": {
            "$ref": "#/$defs/InvariantExecutionCandidateProvenance"
          },
          "maxItems": 100,
          "title": "Execution Provenance",
          "type": "array"
        },
        "false_positive_conditions": {
          "items": {
            "type": "string"
          },
          "title": "False Positive Conditions",
          "type": "array"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "location_validation": {
          "$ref": "#/$defs/LocationValidation"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "title": "Locations",
          "type": "array"
        },
        "model_votes": {
          "items": {
            "$ref": "#/$defs/ModelVote"
          },
          "title": "Model Votes",
          "type": "array"
        },
        "origin_kind": {
          "$ref": "#/$defs/FindingOriginKind",
          "default": "model_review"
        },
        "owasp": {
          "items": {
            "type": "string"
          },
          "title": "Owasp",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "recommendation": {
          "default": "",
          "title": "Recommendation",
          "type": "string"
        },
        "reproduction_state": {
          "$ref": "#/$defs/ReproductionState",
          "default": "not_attempted"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSink"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSink"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification_test": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationTest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "severity",
        "confidence",
        "summary",
        "impact",
        "location_validation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingActorAssessment": {
      "additionalProperties": false,
      "properties": {
        "action_against_stated_interest": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Against Stated Interest"
        },
        "actor_model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Model Sha256"
        },
        "actor_model_source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Model Source Sha256"
        },
        "applied_constraint_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Applied Constraint Ids",
          "type": "array"
        },
        "assessment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessment Sha256",
          "type": "string"
        },
        "baseline_finding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Finding Sha256",
          "type": "string"
        },
        "calibrated_severity": {
          "$ref": "#/$defs/ActorSeverity"
        },
        "capital_consumed_before_harmed_party": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Consumed Before Harmed Party"
        },
        "concentrated_with_role_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Concentrated With Role Ids",
          "type": "array"
        },
        "disposition": {
          "$ref": "#/$defs/ActorAssessmentDisposition"
        },
        "governance_conflict_id": {
          "anyOf": [
            {
              "pattern": "^actor-governance:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governance Conflict Id"
        },
        "harmed_party_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorHarmedPartyDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "harmed_party_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harmed Party Id"
        },
        "holder_fee_revenue_exposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorExposureState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "holder_party_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder Party Id"
        },
        "holder_protocol_failure_loss": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorExposureState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_state": {
          "$ref": "#/$defs/ActorModelInputState"
        },
        "likelihood_adjustment": {
          "$ref": "#/$defs/ActorLikelihoodAdjustment"
        },
        "limitation": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "misconduct_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misconduct Required"
        },
        "ordinary_legitimate_behavior": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinary Legitimate Behavior"
        },
        "original_severity": {
          "$ref": "#/$defs/ActorSeverity"
        },
        "permission": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission"
        },
        "plausibility_evidence_reference_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Plausibility Evidence Reference Ids",
          "type": "array"
        },
        "plausibility_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plausibility Rationale"
        },
        "privileged_action_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privileged Action Required"
        },
        "relevant_economic_exposures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorEconomicExposureKind"
          },
          "maxItems": 2,
          "title": "Relevant Economic Exposures",
          "type": "array"
        },
        "remediation_focus": {
          "$ref": "#/$defs/ActorRemediationFocus"
        },
        "required_concentrated_role_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Concentrated Role Ids",
          "type": "array"
        },
        "role_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Id"
        },
        "role_occupancy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRoleOccupancy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity_basis": {
          "anyOf": [
            {
              "const": "code_mechanism_only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Basis"
        },
        "stated_interest": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stated Interest"
        }
      },
      "required": [
        "input_state",
        "disposition",
        "baseline_finding_sha256",
        "original_severity",
        "calibrated_severity",
        "likelihood_adjustment",
        "remediation_focus",
        "assessment_sha256"
      ],
      "title": "FindingActorAssessment",
      "type": "object"
    },
    "FindingOriginKind": {
      "description": "Trusted discovery origin retained on a normalized finding.",
      "enum": [
        "model_review",
        "deterministic_execution",
        "static_analyzer"
      ],
      "title": "FindingOriginKind",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "confirmed",
        "strongly_supported",
        "high_confidence",
        "plausible",
        "needs_review",
        "informational",
        "insufficient_context",
        "unsupported",
        "rejected"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "InvariantExecutionCandidateProvenance": {
      "additionalProperties": false,
      "description": "Self-hashed origin evidence for one replayed deterministic counterexample.",
      "properties": {
        "attempts": {
          "maximum": 10,
          "minimum": 2,
          "title": "Attempts",
          "type": "integer"
        },
        "compiler_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Compiler Sha256",
          "type": "string"
        },
        "compiler_version": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Compiler Version",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        },
        "execution_evidence": {
          "const": "real",
          "default": "real",
          "title": "Execution Evidence",
          "type": "string"
        },
        "execution_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Observation Sha256",
          "type": "string"
        },
        "execution_result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Result Sha256",
          "type": "string"
        },
        "harness_name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Harness Name",
          "type": "string"
        },
        "harness_spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Harness Spec Sha256",
          "type": "string"
        },
        "invariant_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invariant Evidence Sha256",
          "type": "string"
        },
        "invariant_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Invariant Id",
          "type": "string"
        },
        "isolation_attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Isolation Attestation Sha256",
          "type": "string"
        },
        "isolation_backend": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Isolation Backend",
          "type": "string"
        },
        "minimized": {
          "title": "Minimized",
