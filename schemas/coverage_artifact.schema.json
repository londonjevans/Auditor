  "$id": "https://mmaudit.local/schemas/coverage_artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compact typed coverage projection with full typed coverage bodies retained.",
  "properties": {
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model_review_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelReviewCoverage"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_gates": {
      "items": {
        "$ref": "#/$defs/QualityGateResult"
      },
      "title": "Quality Gates",
      "type": "array"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/AuditRunStatus"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditScopeAssessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "solidity_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SolidityCoverage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "run_status",
    "completed",
    "scope_assessment",
    "solidity_coverage",
    "model_review_coverage",
    "quality_gates",
    "limitations"
  ],
  "title": "mmaudit forensic coverage artifact",
  "type": "object"
}
