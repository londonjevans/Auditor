{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmaudit.local/schemas/run_evidence_manifest.schema.json",
  "title": "mmaudit hash-linked run evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "tool_version",
    "run_id",
    "repository_root_name",
    "git_commit",
    "sources",
    "source_tree_sha256",
    "bindings",
    "artifacts",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "generated_by": {
      "const": "mmaudit"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository_root_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/fileBinding"
      }
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/runConfiguration"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindings": {
      "$ref": "#/$defs/bindingSet"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/fileBinding"
      }
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "run_configuration": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "run_configuration"
        ],
        "properties": {
          "run_configuration": {
            "$ref": "#/$defs/runConfiguration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "audit-report.md"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "audit-results.sarif"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "client-report.md"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "coverage.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "findings.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "forensic-report.md"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "model-execution.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "maxContains": 1,
                "minContains": 1
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hashBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "sha256",
        "details"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "details": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "auditConfigOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "enum": [
            "execution.budget_usd",
            "execution.concurrency",
            "execution.cost_ledger_path",
            "execution.max_request_bytes",
            "maximum_assurance.allow_downgrade",
            "maximum_assurance.benchmark_gate",
            "maximum_assurance.minimum_model_families",
            "maximum_assurance.minimum_specialist_agents",
            "maximum_assurance.require",
            "maximum_assurance.require_formal_or_reproduction_for_confirmed_critical",
            "maximum_assurance.require_reproduction_for_critical",
            "models.minimum_distinct_families",
            "prior_audit.fail_on_missed",
            "prior_audit.path",
            "prior_audit.required",
            "privacy.allow_code_egress",
            "privacy.maximum_model_retention",
            "privacy.profile",
            "privacy.require_zdr",
            "profile",
            "repository.max_discovery_bytes",
            "repository.max_file_bytes",
            "repository.max_files",
            "repository.max_total_context_bytes",
            "repository.max_walk_entries",
            "reproduction.expected_chain_id",
            "reproduction.pinned_block_number",
            "reproduction.require_hardened_isolation",
            "reproduction.rootless_container_image",
            "reproduction.rootless_container_runtime",
            "scanners.foundry_fork.enabled",
            "scanners.hardhat_fork.enabled",
            "scanners.slither.enabled",
            "scope.mode",
            "scope.require_complete",
            "smart_contracts.allow_fork_probing",
            "smart_contracts.allow_network",
            "smart_contracts.compile",
            "smart_contracts.enabled",
            "smart_contracts.fork_rpc_url_env",
            "smart_contracts.foundry_match_path",
            "smart_contracts.framework",
            "smart_contracts.project_root",
            "smart_contracts.require_local_fork_rpc"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "enum": [
                "maximum_assurance.allow_downgrade",
                "maximum_assurance.benchmark_gate",
                "maximum_assurance.require",
                "maximum_assurance.require_formal_or_reproduction_for_confirmed_critical",
                "maximum_assurance.require_reproduction_for_critical",
                "prior_audit.fail_on_missed",
                "prior_audit.required",
                "privacy.allow_code_egress",
                "privacy.require_zdr",
                "reproduction.require_hardened_isolation",
                "scanners.foundry_fork.enabled",
                "scanners.hardhat_fork.enabled",
                "scanners.slither.enabled",
                "scope.require_complete",
                "smart_contracts.allow_fork_probing",
                "smart_contracts.allow_network",
                "smart_contracts.compile",
                "smart_contracts.enabled",
                "smart_contracts.require_local_fork_rpc"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "enum": [
                "execution.concurrency",
                "execution.max_request_bytes",
                "maximum_assurance.minimum_model_families",
                "maximum_assurance.minimum_specialist_agents",
                "models.minimum_distinct_families",
                "repository.max_discovery_bytes",
                "repository.max_file_bytes",
                "repository.max_files",
                "repository.max_total_context_bytes",
                "repository.max_walk_entries",
                "reproduction.expected_chain_id",
                "reproduction.pinned_block_number"
              ]
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "enum": [
                "execution.budget_usd"
              ]
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "enum": [
                "execution.cost_ledger_path",
                "prior_audit.path",
                "privacy.maximum_model_retention",
                "privacy.profile",
                "profile",
                "reproduction.rootless_container_image",
                "reproduction.rootless_container_runtime",
                "scope.mode",
                "smart_contracts.fork_rpc_url_env",
                "smart_contracts.foundry_match_path",
                "smart_contracts.framework",
                "smart_contracts.project_root"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "auditConfigOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 44,
          "items": {
            "$ref": "#/$defs/auditConfigOverride"
          }
        }
      }
    },
    "auditRunOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner_only",
        "allow_code_egress",
        "skip_codeql",
        "changed_since",
        "severity_threshold",
        "fail_on",
        "refresh_models",
        "allow_fork_probing",
        "require_maximum_assurance",
        "allow_maximum_assurance_downgrade",
        "benchmark_repository_git_commit",
        "privacy_source_classification",
        "retention_consent_file_sha256"
      ],
      "properties": {
        "scanner_only": {
          "type": "boolean"
        },
        "allow_code_egress": {
          "type": "boolean"
        },
        "skip_codeql": {
          "type": "boolean"
        },
        "changed_since": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity_threshold": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "fail_on": {
          "anyOf": [
            {
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_models": {
          "type": "boolean"
        },
        "allow_fork_probing": {
          "type": "boolean"
        },
        "require_maximum_assurance": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allow_maximum_assurance_downgrade": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "benchmark_repository_git_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy_source_classification": {
          "enum": [
            "PRIVATE_OPERATOR_SOURCE",
            "SYNTHETIC_COMMITTED",
            "PUBLIC_BENCHMARK"
          ]
        },
        "retention_consent_file_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_configuration_json",
        "file_config_sha256",
        "environment_overrides",
        "environment_overrides_sha256",
        "cli_overrides",
        "cli_overrides_sha256",
        "run_options",
        "run_options_sha256",
        "effective_configuration_json",
        "effective_config_sha256",
        "model_config_sha256",
        "invocation_sha256",
        "requested_profile",
        "achieved_profile"
      ],
      "properties": {
        "file_configuration_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000000
        },
        "file_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_overrides": {
          "$ref": "#/$defs/auditConfigOverrides"
        },
        "environment_overrides_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cli_overrides": {
          "$ref": "#/$defs/auditConfigOverrides"
        },
        "cli_overrides_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_options": {
          "$ref": "#/$defs/auditRunOptions"
        },
        "run_options_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effective_configuration_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000000
        },
        "effective_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "invocation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_profile": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "maximum-assurance"
          ]
        },
        "achieved_profile": {
          "anyOf": [
            {
              "enum": [
                "quick",
                "standard",
                "deep",
                "maximum-assurance"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bindingSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "prompts",
        "models",
        "tools",
        "compilers",
        "isolation",
        "seeds",
        "corpora",
        "harnesses",
        "reproductions",
        "coverage"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/configurationBindings"
        },
        "prompts": {
          "$ref": "#/$defs/standardBindings"
        },
        "models": {
          "$ref": "#/$defs/standardBindings"
        },
        "tools": {
          "$ref": "#/$defs/standardBindings"
        },
        "compilers": {
          "$ref": "#/$defs/standardBindings"
        },
        "isolation": {
          "$ref": "#/$defs/standardBindings"
        },
        "seeds": {
          "$ref": "#/$defs/largeBindings"
        },
        "corpora": {
          "$ref": "#/$defs/standardBindings"
        },
        "harnesses": {
          "$ref": "#/$defs/largeBindings"
        },
        "reproductions": {
          "$ref": "#/$defs/largeBindings"
        },
        "coverage": {
          "$ref": "#/$defs/standardBindings"
        }
      }
    },
    "configurationBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/hashBinding"
      }
    },
    "standardBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/hashBinding"
      }
    },
    "largeBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/hashBinding"
      }
    }
  }
}
