{
  "$defs": {
    "AuditProfile": {
      "enum": [
        "quick",
        "standard",
        "deep",
        "maximum-assurance"
      ],
      "title": "AuditProfile",
      "type": "string"
    },
    "LanguageCapabilityProfile": {
      "description": "Explicit product capability selected independently of analysis depth.",
      "enum": [
        "solidity-evm",
        "generic-source-review"
      ],
      "title": "LanguageCapabilityProfile",
      "type": "string"
    },
    "LanguageCapabilityStatus": {
      "description": "Evidence-derived relationship between requested capability and audited source.",
      "enum": [
        "MATCHED",
        "REDUCED",
        "MISMATCH",
        "INCONCLUSIVE"
      ],
      "title": "LanguageCapabilityStatus",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/release_run_binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed binding derived from two fresh observations of one run.",
  "properties": {
    "achieved_language_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/LanguageCapabilityProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "achieved_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_count": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Artifact Count",
      "type": "integer"
    },
    "artifact_evidence_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Evidence File Sha256",
      "type": "string"
    },
    "artifact_evidence_file_size": {
      "maximum": 100000000,
      "minimum": 1,
      "title": "Artifact Evidence File Size",
      "type": "integer"
    },
    "artifact_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Evidence Sha256",
      "type": "string"
    },
    "artifact_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Inventory Sha256",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "capability_status": {
      "$ref": "#/$defs/LanguageCapabilityStatus"
    },
    "cli_overrides_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cli Overrides Sha256",
      "type": "string"
    },
    "effective_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effective Config Sha256",
      "type": "string"
    },
    "environment_overrides_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Overrides Sha256",
      "type": "string"
    },
    "file_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "File Config Sha256",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "invocation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Invocation Sha256",
      "type": "string"
    },
    "language_capability_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Language Capability Sha256",
      "type": "string"
    },
    "manifest_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest File Sha256",
      "type": "string"
    },
    "manifest_path": {
      "const": "run-evidence-manifest.json",
      "title": "Manifest Path",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "model_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Config Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "reduced_language_capability": {
      "title": "Reduced Language Capability",
      "type": "boolean"
    },
    "requested_language_profile": {
      "$ref": "#/$defs/LanguageCapabilityProfile"
    },
    "requested_profile": {
      "$ref": "#/$defs/AuditProfile"
    },
    "run_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Configuration Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_options_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Options Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_git_commit": {
      "anyOf": [
        {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Git Commit"
    },
    "target_repository_name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Repository Name",
      "type": "string"
    },
    "target_source_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Source Tree Sha256",
      "type": "string"
    },
    "traceability_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Traceability Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "run_id",
    "target_repository_name",
    "target_git_commit",
    "target_source_tree_sha256",
    "manifest_path",
    "manifest_file_sha256",
    "manifest_sha256",
    "run_configuration_sha256",
    "file_config_sha256",
    "environment_overrides_sha256",
    "cli_overrides_sha256",
    "run_options_sha256",
    "effective_config_sha256",
    "model_config_sha256",
    "invocation_sha256",
    "requested_profile",
    "achieved_profile",
    "requested_language_profile",
    "achieved_language_profile",
    "capability_status",
    "reduced_language_capability",
    "language_capability_sha256",
    "artifact_evidence_file_sha256",
    "artifact_evidence_file_size",
    "artifact_evidence_sha256",
    "artifact_inventory_sha256",
    "artifact_count",
    "traceability_sha256",
    "observed_at",
    "binding_sha256"
  ],
  "title": "ReleaseRunBinding",
  "type": "object"
}
