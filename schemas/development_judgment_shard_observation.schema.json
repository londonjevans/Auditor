{
  "$defs": {
    "ByokObservation": {
      "enum": [
        "ABSENT",
        "FALSE",
        "TRUE",
        "INVALID"
      ],
      "type": "string"
    },
    "CostEntryStatus": {
      "description": "Persisted lifecycle state for one unique provider request.",
      "enum": [
        "reserved",
        "reconciled",
        "released",
        "uncertain_accounted",
        "reservation_overrun"
      ],
      "title": "CostEntryStatus",
      "type": "string"
    },
    "DevelopmentCompletionTelemetry": {
      "additionalProperties": false,
      "description": "Parsed metadata only: the body hash does not authenticate provider usage or identity.",
      "properties": {
        "completion_tokens": {
          "$ref": "#/$defs/DevelopmentTelemetryCount"
        },
        "finish_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/_FinishReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "finish_reason_state": {
          "$ref": "#/$defs/_TelemetryState"
        },
        "interpretation": {
          "const": "REPORTED_METADATA_NOT_VERIFIED_USAGE",
          "default": "REPORTED_METADATA_NOT_VERIFIED_USAGE",
          "title": "Interpretation",
          "type": "string"
        },
        "native_finish_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/_NativeFinishReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_finish_reason_state": {
          "$ref": "#/$defs/_TelemetryState"
        },
        "prompt_tokens": {
          "$ref": "#/$defs/DevelopmentTelemetryCount"
        },
        "reasoning_subset_consistency": {
          "$ref": "#/$defs/_Consistency"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/DevelopmentTelemetryCount"
        },
        "response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "token_sum_consistency": {
          "$ref": "#/$defs/_Consistency"
        },
        "total_tokens": {
          "$ref": "#/$defs/DevelopmentTelemetryCount"
        }
      },
      "required": [
        "response_sha256",
        "finish_reason",
        "finish_reason_state",
        "native_finish_reason",
        "native_finish_reason_state",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "reasoning_tokens",
        "token_sum_consistency",
        "reasoning_subset_consistency"
      ],
      "title": "DevelopmentCompletionTelemetry",
      "type": "object"
    },
    "DevelopmentCorpusId": {
      "enum": [
        "unit-ledger-a-v1",
        "unit-ledger-b-v1"
      ],
      "type": "string"
    },
    "DevelopmentCostComponent": {
      "additionalProperties": false,
      "description": "One observed rate and the deliberately conservative estimation allowance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/DevelopmentPriceField"
        },
        "estimated_unit_price_usd": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Unit Price Usd"
        },
        "estimated_units": {
          "maximum": 4000000,
          "minimum": 0,
          "title": "Estimated Units",
          "type": "integer"
        },
        "observed_unit_price_usd": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Observed Unit Price Usd"
        }
      },
      "required": [
        "component",
        "observed_unit_price_usd",
        "estimated_unit_price_usd",
        "estimated_units"
      ],
      "title": "DevelopmentCostComponent",
      "type": "object"
    },
    "DevelopmentCostEstimate": {
      "additionalProperties": false,
      "description": "Non-qualifying explanatory output, not an admission or execution capability.",
      "properties": {
        "artifact_kind": {
          "const": "development_cost_estimate",
          "default": "development_cost_estimate",
          "title": "Artifact Kind",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/DevelopmentCostComponent"
          },
          "maxItems": 7,
          "minItems": 2,
          "title": "Components",
          "type": "array"
        },
        "endpoint_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Snapshot Sha256",
          "type": "string"
        },
        "estimated_cost_all_attempts_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost All Attempts Usd"
        },
        "estimated_cost_per_attempt_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost Per Attempt Usd"
        },
        "exact_model_id": {
          "title": "Exact Model Id",
          "type": "string"
        },
        "maximum_completion_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Maximum Completion Tokens",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/DevelopmentCostPolicy"
        },
        "provider_endpoint": {
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_enforced_ceiling": {
          "const": false,
          "default": false,
          "title": "Provider Enforced Ceiling",
          "type": "boolean"
        },
        "qualification_eligible": {
          "const": false,
          "default": false,
          "title": "Qualification Eligible",
          "type": "boolean"
        },
        "release_eligible": {
          "const": false,
          "default": false,
          "title": "Release Eligible",
          "type": "boolean"
        },
        "request_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 4000000,
          "title": "Request Bytes",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "warning": {
          "const": "DEVELOPMENT ONLY: estimated costs may exceed reservations and the budget target. This is not a provider-enforced ceiling or qualification/release evidence.",
          "default": "DEVELOPMENT ONLY: estimated costs may exceed reservations and the budget target. This is not a provider-enforced ceiling or qualification/release evidence.",
          "title": "Warning",
          "type": "string"
        },
        "within_estimated_budget": {
          "title": "Within Estimated Budget",
          "type": "boolean"
        }
      },
      "required": [
        "policy",
        "request_id",
        "request_sha256",
        "endpoint_snapshot_sha256",
        "exact_model_id",
        "provider_endpoint",
        "request_bytes",
        "maximum_completion_tokens",
        "components",
        "estimated_cost_per_attempt_usd",
        "estimated_cost_all_attempts_usd",
        "within_estimated_budget"
      ],
      "title": "DevelopmentCostEstimate",
      "type": "object"
    },
    "DevelopmentCostPolicy": {
      "additionalProperties": false,
      "description": "Explicit target budgets, not hard guarantees; defaults keep retries off.",
      "properties": {
        "maximum_attempts": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "overspend_risk_accepted": {
          "const": true,
          "title": "Overspend Risk Accepted",
          "type": "boolean"
        },
        "per_attempt_budget_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Per Attempt Budget Usd",
          "type": "string"
        },
        "purpose": {
          "const": "DEVELOPMENT_ONLY_ESTIMATED",
          "default": "DEVELOPMENT_ONLY_ESTIMATED",
          "title": "Purpose",
          "type": "string"
        },
        "request_timeout_seconds": {
          "anyOf": [
            {
              "maximum": 1800,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Timeout Seconds"
        },
        "safety_multiplier": {
          "default": "2",
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Safety Multiplier",
          "type": "string"
        },
        "total_budget_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Total Budget Usd",
          "type": "string"
        },
        "uncertain_cost_policy": {
          "default": "STOP",
          "enum": [
            "STOP",
            "CARRY_RESERVED_ESTIMATE"
          ],
          "title": "Uncertain Cost Policy",
          "type": "string"
        }
      },
      "required": [
        "overspend_risk_accepted",
        "total_budget_usd",
        "per_attempt_budget_usd"
      ],
      "title": "DevelopmentCostPolicy",
      "type": "object"
    },
    "DevelopmentJudgmentClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^file-0[123]:(?:0[1-9]|1[0-6])$",
          "title": "Claim Id",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/DevelopmentScoredFinding"
        }
      },
      "required": [
        "claim_id",
        "finding"
      ],
      "title": "DevelopmentJudgmentClaim",
      "type": "object"
    },
    "DevelopmentJudgmentDecision": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Source-grounded review of one immutable hypothesis, not a validated finding.",
          "properties": {
            "claim_id": {
              "pattern": "^file-0[123]:(?:0[1-9]|1[0-6])$",
              "title": "Claim Id",
              "type": "string"
            },
            "explanation": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Explanation",
              "type": "string"
            },
            "source_refs": {
              "items": {
                "$ref": "#/$defs/DevelopmentRootCauseReference"
              },
              "maxItems": 6,
              "minItems": 1,
              "title": "Source Refs",
              "type": "array"
            },
            "verdict": {
              "enum": [
                "SUPPORTED",
                "REFUTED"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "claim_id",
            "verdict",
            "explanation",
            "source_refs"
          ],
          "title": "DevelopmentJudgmentDecision",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Source-grounded review of one immutable hypothesis, not a validated finding.",
          "properties": {
            "claim_id": {
              "pattern": "^file-0[123]:(?:0[1-9]|1[0-6])$",
              "title": "Claim Id",
              "type": "string"
            },
            "explanation": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Explanation",
              "type": "string"
            },
            "source_refs": {
              "items": {
                "$ref": "#/$defs/DevelopmentRootCauseReference"
              },
              "maxItems": 6,
              "minItems": 0,
              "title": "Source Refs",
              "type": "array"
            },
            "verdict": {
              "enum": [
                "INCONCLUSIVE"
              ],
              "title": "Verdict",
              "type": "string"
            }
          },
          "required": [
            "claim_id",
            "verdict",
            "explanation",
            "source_refs"
          ],
          "title": "DevelopmentJudgmentDecision",
          "type": "object"
        }
      ],
      "description": "Source-grounded review of one immutable hypothesis, not a validated finding.",
      "title": "DevelopmentJudgmentDecision"
    },
    "DevelopmentJudgmentResponse": {
      "additionalProperties": false,
      "description": "Bounded candidate decisions; neither support nor a citation grants assurance.",
      "properties": {
        "decisions": {
          "items": {
            "$ref": "#/$defs/DevelopmentJudgmentDecision"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "summary",
        "decisions"
      ],
      "title": "DevelopmentJudgmentResponse",
      "type": "object"
    },
    "DevelopmentPriceField": {
      "enum": [
        "prompt",
        "completion",
        "input_cache_read",
        "input_cache_write",
        "request",
        "image",
        "web_search"
      ],
      "type": "string"
    },
    "DevelopmentResponseFailureReason": {
      "enum": [
        "CONTENT_ENCODING",
        "CONTENT_LENGTH",
        "RESPONSE_SIZE",
        "RESPONSE_JSON",
        "GENERATION_ID",
        "COMPLETION_OBJECT",
        "USAGE",
        "TOKEN_COUNTS",
        "SERVER_TOOLS",
        "CHOICES",
        "CHOICE_INDEX",
        "MESSAGE",
        "STRUCTURED_OUTPUT",
        "FINDING_LINE_BOUNDS",
        "ORIGIN_FILE_SCOPE",
        "ORIGIN_LINE_BOUNDS"
      ],
      "title": "DevelopmentResponseFailureReason",
      "type": "string"
    },
    "DevelopmentResponseField": {
      "enum": [
        "response",
        "schema_version",
        "summary",
        "findings",
        "finding",
        "title",
        "severity",
        "line_start",
        "line_end",
        "kind",
        "vulnerability_class",
        "violated_invariant",
        "root_cause_ref",
        "root_cause_ref.filename",
        "root_cause_ref.line_start",
        "root_cause_ref.line_end",
        "explanation",
        "recommendation"
      ],
      "title": "DevelopmentResponseField",
      "type": "string"
    },
    "DevelopmentResponseRejection": {
      "additionalProperties": false,
      "description": "Hash-bound refusal detail, meaningful only with its incomplete parent observation.",
      "properties": {
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevelopmentResponseField"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finding_index": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Index"
        },
        "reason": {
          "$ref": "#/$defs/DevelopmentResponseFailureReason"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "schema_issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DevelopmentSchemaIssue"
          },
          "maxItems": 8,
          "title": "Schema Issues",
          "type": "array"
        },
        "schema_issues_truncated": {
          "default": false,
          "title": "Schema Issues Truncated",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "HTTP_BODY",
            "COMPLETION_ENVELOPE",
            "STRUCTURED_OUTPUT",
            "SOURCE_SCOPE"
          ],
          "title": "Stage",
          "type": "string"
        },
        "structured_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredOutputFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "stage",
        "reason"
      ],
      "title": "DevelopmentResponseRejection",
      "type": "object"
    },
    "DevelopmentReviewDiagnostic": {
      "enum": [
        "HTTP_ERROR",
        "TRANSPORT_ERROR",
        "TIMEOUT",
        "INVALID_RESPONSE",
        "IDENTITY_MISMATCH",
        "INCOMPLETE_OUTPUT",
        "SECRET_OUTPUT",
        "UNKNOWN_COST",
        "COST_OVERRUN"
      ],
      "title": "DevelopmentReviewDiagnostic",
      "type": "string"
    },
    "DevelopmentRootCauseReference": {
      "additionalProperties": false,
      "description": "Model-proposed origin coordinates, never proof that a root cause is valid.",
      "properties": {
        "filename": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,95}\\.sol$",
          "title": "Filename",
          "type": "string"
        },
        "line_end": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "line_start",
        "line_end"
      ],
      "title": "DevelopmentRootCauseReference",
      "type": "object"
    },
    "DevelopmentRoutingContext": {
      "additionalProperties": false,
      "description": "Supplied request/discovery binding, not independently authenticated provider evidence.",
      "properties": {
        "canonical_model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Model Id"
        },
        "catalog_identity_binding_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Identity Binding Sha256"
        },
        "endpoint_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Snapshot Sha256",
          "type": "string"
        },
        "exact_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Exact Model Id",
          "type": "string"
        },
        "identity_basis": {
          "enum": [
            "REQUEST_ID_ONLY",
            "SUPPLIED_DISCOVERY_BOUND"
          ],
          "title": "Identity Basis",
          "type": "string"
        },
        "model_metadata_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Metadata Snapshot Sha256"
        },
        "provider_endpoint": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        }
      },
      "required": [
        "exact_model_id",
        "provider_endpoint",
        "provider_name",
        "endpoint_snapshot_sha256",
        "identity_basis"
      ],
      "title": "DevelopmentRoutingContext",
      "type": "object"
    },
    "DevelopmentRoutingEndpoint": {
      "additionalProperties": false,
      "properties": {
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "model": {
          "$ref": "#/$defs/DevelopmentRoutingIdentity"
        },
        "provider": {
          "$ref": "#/$defs/DevelopmentRoutingIdentity"
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "title": "DevelopmentRoutingEndpoint",
      "type": "object"
    },
    "DevelopmentRoutingEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "development_routing_observation",
          "default": "development_routing_observation",
          "title": "Artifact Kind",
          "type": "string"
        },
        "attempt_count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Count"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/DevelopmentRoutingEndpoint"
          },
          "maxItems": 128,
          "title": "Attempts",
          "type": "array"
        },
        "available_count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Count"
        },
        "context": {
          "$ref": "#/$defs/DevelopmentRoutingContext"
        },
        "endpoint_total": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endpoint Total"
        },
        "evidence_class": {
          "const": "BOUNDED_UNTRUSTED_PROVIDER_OBSERVATION",
          "default": "BOUNDED_UNTRUSTED_PROVIDER_OBSERVATION",
          "title": "Evidence Class",
          "type": "string"
        },
        "failure_codes": {
          "items": {
            "$ref": "#/$defs/DevelopmentRoutingFailure"
          },
          "maxItems": 20,
          "title": "Failure Codes",
          "type": "array"
        },
        "metadata_shape": {
          "enum": [
            "ABSENT",
            "OBJECT",
            "INVALID"
          ],
          "title": "Metadata Shape",
          "type": "string"
        },
        "pipeline_count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pipeline Count"
        },
        "requested_model": {
          "$ref": "#/$defs/DevelopmentRoutingIdentity"
        },
        "response_provider": {
          "$ref": "#/$defs/DevelopmentRoutingIdentity"
        },
        "returned_model": {
          "$ref": "#/$defs/DevelopmentRoutingIdentity"
        },
        "router_attempt": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Router Attempt"
        },
        "router_byok": {
          "$ref": "#/$defs/ByokObservation"
        },
        "runtime_authority": {
          "const": false,
          "default": false,
          "title": "Runtime Authority",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_endpoints": {
          "items": {
            "$ref": "#/$defs/DevelopmentRoutingEndpoint"
          },
          "maxItems": 128,
          "title": "Selected Endpoints",
          "type": "array"
        },
        "strategy": {
          "enum": [
            "ABSENT",
            "DIRECT",
            "OTHER",
            "INVALID"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "usage_byok": {
          "$ref": "#/$defs/ByokObservation"
        }
      },
      "required": [
        "context",
        "returned_model",
        "response_provider",
        "requested_model",
        "metadata_shape",
        "strategy",
        "router_attempt",
        "router_byok",
        "usage_byok",
        "endpoint_total",
        "available_count",
        "selected_endpoints",
        "attempt_count",
        "attempts",
        "pipeline_count",
        "failure_codes"
      ],
      "title": "DevelopmentRoutingEvidence",
      "type": "object"
    },
    "DevelopmentRoutingFailure": {
      "enum": [
        "RETURNED_MODEL",
        "RESPONSE_PROVIDER",
        "ROUTER_METADATA",
        "REQUESTED_MODEL",
        "STRATEGY",
        "ROUTER_ATTEMPT",
        "BYOK_EVIDENCE_MISSING",
        "BYOK_REPORTED",
        "BYOK_INVALID",
        "PIPELINE",
        "ENDPOINT_SHAPE",
        "SELECTION_COUNT",
        "SELECTED_MODEL",
        "SELECTED_PROVIDER",
        "ATTEMPT_SHAPE",
        "ATTEMPT_MODEL",
        "ATTEMPT_PROVIDER",
        "ATTEMPT_STATUS",
        "GENERATION_HEADER",
        "GENERATION_REUSE"
      ],
      "title": "DevelopmentRoutingFailure",
      "type": "string"
    },
    "DevelopmentRoutingIdentity": {
      "additionalProperties": false,
      "description": "Unknown response strings are suppressed completely, not heuristically echoed.",
      "properties": {
        "status": {
          "enum": [
            "REQUESTED",
            "CANONICAL",
            "PROVIDER",
            "UNBOUND",
            "ABSENT",
            "INVALID",
            "REDACTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "DevelopmentRoutingIdentity",
      "type": "object"
    },
    "DevelopmentSchemaConstraint": {
      "enum": [
        "REQUIRED_FIELD",
        "EXTRA_FIELD",
        "FIELD_TYPE",
        "ENUM_VALUE",
        "FIELD_BOUND",
        "FIELD_FORMAT",
        "LINE_ORDER",
        "ADVISORY_FIELD_MUST_BE_NULL",
        "INVARIANT_FIELD_MUST_BE_SET",
        "SCHEMA_CONSTRAINT"
      ],
      "title": "DevelopmentSchemaConstraint",
      "type": "string"
    },
    "DevelopmentSchemaIssue": {
      "additionalProperties": false,
      "description": "A known schema coordinate, never an input-authored key, value or error message.",
      "properties": {
        "constraint": {
          "$ref": "#/$defs/DevelopmentSchemaConstraint"
        },
        "field": {
          "$ref": "#/$defs/DevelopmentResponseField"
        },
        "finding_index": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finding Index"
        }
      },
      "required": [
        "constraint",
        "field",
        "finding_index"
      ],
      "title": "DevelopmentSchemaIssue",
      "type": "object"
    },
    "DevelopmentScoredFinding": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Explicit v2 claim semantics; neither kind nor origin is a correctness verdict.",
          "properties": {
            "explanation": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Explanation",
              "type": "string"
            },
            "kind": {
              "enum": [
                "advisory"
              ],
              "title": "Kind",
              "type": "string"
            },
            "line_end": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Line End",
              "type": "integer"
            },
            "line_start": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Line Start",
              "type": "integer"
            },
            "recommendation": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Recommendation",
              "type": "string"
            },
            "root_cause_ref": {
              "type": "null"
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "violated_invariant": {
              "title": "Violated Invariant",
              "type": "null"
            },
            "vulnerability_class": {
              "title": "Vulnerability Class",
              "type": "null"
            }
          },
          "required": [
            "title",
            "severity",
            "line_start",
            "line_end",
            "kind",
            "vulnerability_class",
            "violated_invariant",
            "root_cause_ref",
            "explanation",
            "recommendation"
          ],
          "title": "DevelopmentScoredFinding",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit v2 claim semantics; neither kind nor origin is a correctness verdict.",
          "properties": {
            "explanation": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Explanation",
              "type": "string"
            },
            "kind": {
              "enum": [
                "invariant_violation"
              ],
              "title": "Kind",
              "type": "string"
            },
            "line_end": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Line End",
              "type": "integer"
            },
            "line_start": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Line Start",
              "type": "integer"
            },
            "recommendation": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Recommendation",
              "type": "string"
            },
            "root_cause_ref": {
              "$ref": "#/$defs/DevelopmentRootCauseReference"
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "violated_invariant": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Violated Invariant",
              "type": "string"
            },
            "vulnerability_class": {
              "enum": [
                "access_control",
                "accounting",
                "reservation",
                "pause",
                "other"
              ],
              "title": "Vulnerability Class",
              "type": "string"
            }
          },
          "required": [
            "title",
            "severity",
            "line_start",
            "line_end",
            "kind",
            "vulnerability_class",
            "violated_invariant",
            "root_cause_ref",
            "explanation",
            "recommendation"
          ],
          "title": "DevelopmentScoredFinding",
          "type": "object"
        }
      ],
      "description": "Explicit v2 claim semantics; neither kind nor origin is a correctness verdict.",
      "title": "DevelopmentScoredFinding"
    },
    "DevelopmentTelemetryCount": {
      "additionalProperties": false,
      "description": "One reported bounded integer; missing and invalid values are not zero.",
      "properties": {
        "state": {
          "enum": [
            "REPORTED",
            "NOT_REPORTED",
            "INVALID"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "title": "DevelopmentTelemetryCount",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StructuredOutputFailureCode": {
      "description": "Non-secret classification for one rejected structured response.",
      "enum": [
        "TRUNCATED_RESPONSE",
        "INVALID_JSON_SYNTAX",
        "DUPLICATE_OBJECT_KEY",
