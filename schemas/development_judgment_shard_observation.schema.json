  },
  "$id": "https://mmaudit.local/schemas/development_judgment_shard_observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounted_cost_usd": {
      "anyOf": [
        {
          "exclusiveMaximum": 1000000000000.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Accounted Cost Usd"
    },
    "accounting_status": {
      "$ref": "#/$defs/CostEntryStatus"
    },
    "artifact_kind": {
      "const": "development_judgment_shard_observation",
      "default": "development_judgment_shard_observation",
      "title": "Artifact Kind",
      "type": "string"
    },
    "attempt": {
      "maximum": 32,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "audit_complete": {
      "const": false,
      "default": false,
      "title": "Audit Complete",
      "type": "boolean"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/DevelopmentJudgmentClaim"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "completion_telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/DevelopmentCompletionTelemetry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "corpus_id": {
      "$ref": "#/$defs/DevelopmentCorpusId"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/DevelopmentReviewDiagnostic"
      },
      "maxItems": 10,
      "title": "Diagnostics",
      "type": "array"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "estimate": {
      "$ref": "#/$defs/DevelopmentCostEstimate"
    },
    "findings_validated": {
      "const": false,
      "default": false,
      "title": "Findings Validated",
      "type": "boolean"
    },
    "generation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generation Id"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Http Status"
    },
    "lineage_independence": {
      "const": "NOT_ESTABLISHED",
      "default": "NOT_ESTABLISHED",
      "title": "Lineage Independence",
      "type": "string"
    },
    "qualification_eligible": {
      "const": false,
      "default": false,
      "title": "Qualification Eligible",
      "type": "boolean"
    },
    "rejection_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/DevelopmentResponseRejection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "release_eligible": {
      "const": false,
      "default": false,
      "title": "Release Eligible",
      "type": "boolean"
    },
    "reported_cost_usd": {
      "anyOf": [
        {
          "exclusiveMaximum": 1000000000000.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reported Cost Usd"
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/DevelopmentJudgmentResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "response_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response Sha256"
    },
    "routing_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/DevelopmentRoutingEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "shard_id": {
      "pattern": "^file-0[123]$",
      "title": "Shard Id",
      "type": "string"
    },
    "source_filename": {
      "title": "Source Filename",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "INCOMPLETE"
      ],
      "title": "Status",
      "type": "string"
    },
    "transport": {
      "enum": [
        "MOCK_HTTP",
        "HTTP_OBSERVATION"
      ],
      "title": "Transport",
      "type": "string"
    }
  },
  "required": [
    "source_filename",
    "source_sha256",
    "estimate",
    "attempt",
    "transport",
    "status",
    "diagnostics",
    "http_status",
    "response_sha256",
    "generation_id",
    "accounting_status",
    "reported_cost_usd",
    "accounted_cost_usd",
    "response",
    "candidate_sha256",
    "corpus_id",
    "run_id",
    "shard_id",
    "claims",
    "elapsed_seconds"
  ],
  "title": "DevelopmentJudgmentShardObservation",
  "type": "object"
}
