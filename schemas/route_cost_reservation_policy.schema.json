{
  "$defs": {
    "LegacyUncertainCostAllowance": {
      "additionalProperties": false,
      "description": "Explicit operator relaxation for two exact rows, with no general carry mechanism.",
      "properties": {
        "allowance_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Allowance Sha256",
          "type": "string"
        },
        "entries": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/LegacyUncertainCostEntry"
            },
            {
              "$ref": "#/$defs/LegacyUncertainCostEntry"
            }
          ],
          "title": "Entries",
          "type": "array"
        },
        "operator_decision_id": {
          "const": "OP-COSTLEGACY-2026-09-11",
          "default": "OP-COSTLEGACY-2026-09-11",
          "title": "Operator Decision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "allowance_sha256"
      ],
      "title": "LegacyUncertainCostAllowance",
      "type": "object"
    },
    "LegacyUncertainCostEntry": {
      "additionalProperties": false,
      "description": "Bind every immutable identity and retained liability field of one approved row.",
      "properties": {
        "accounted_cost_usd_exact": {
          "enum": [
            "0.18105",
            "0.05225616"
          ],
          "title": "Accounted Cost Usd Exact",
          "type": "string"
        },
        "actual_cost_usd": {
          "default": null,
          "title": "Actual Cost Usd",
          "type": "null"
        },
        "created_at": {
          "maxLength": 32,
          "minLength": 25,
          "title": "Created At",
          "type": "string"
        },
        "release_reason": {
          "default": null,
          "title": "Release Reason",
          "type": "null"
        },
        "request_id": {
          "pattern": "^authrunner\\.smoke\\.(?:r17\\.judge\\.replay|r2\\.candidate\\.primary):[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "reservation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Reservation Id",
          "type": "string"
        },
        "reserved_usd_exact": {
          "enum": [
            "0.18105",
            "0.05225616"
          ],
          "title": "Reserved Usd Exact",
          "type": "string"
        },
        "status": {
          "const": "uncertain_accounted",
          "default": "uncertain_accounted",
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "maxLength": 32,
          "minLength": 25,
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "reservation_id",
        "created_at",
        "updated_at",
        "reserved_usd_exact",
        "accounted_cost_usd_exact"
      ],
      "title": "LegacyUncertainCostEntry",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/route_cost_reservation_policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "legacy_uncertain_allowance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "properties": {
          "legacy_uncertain_allowance": {
            "type": "object"
          }
        },
        "required": [
          "legacy_uncertain_allowance"
        ]
      }
    }
  ],
  "description": "An explicit cost-only relaxation, never inferred from endpoint metadata.",
  "properties": {
    "automatic_ceiling_increase": {
      "const": false,
      "default": false,
      "title": "Automatic Ceiling Increase",
      "type": "boolean"
    },
    "enforcement_basis": {
      "const": "MMAUDIT_OPERATOR_RESERVE_THEN_RECONCILE_V1",
      "default": "MMAUDIT_OPERATOR_RESERVE_THEN_RECONCILE_V1",
      "title": "Enforcement Basis",
      "type": "string"
    },
    "ledger_ceiling_usd_exact": {
      "default": "250",
      "maxLength": 49,
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{0,35}[1-9])?$",
      "title": "Ledger Ceiling Usd Exact",
      "type": "string"
    },
    "legacy_uncertain_allowance": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyUncertainCostAllowance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "maximum_request_bytes": {
      "default": 4000000,
      "maximum": 64000000,
      "minimum": 1024,
      "title": "Maximum Request Bytes",
      "type": "integer"
    },
    "operator_decision_id": {
      "const": "OP-COST-2026-09-09",
      "default": "OP-COST-2026-09-09",
      "title": "Operator Decision Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "provider_enforced_total_ceiling": {
      "const": false,
      "default": false,
      "title": "Provider Enforced Total Ceiling",
      "type": "boolean"
    },
    "require_actual_billed_cost": {
      "const": true,
      "default": true,
      "title": "Require Actual Billed Cost",
      "type": "boolean"
    },
    "reservation_overrun_blocks_new_work": {
      "const": true,
      "default": true,
      "title": "Reservation Overrun Blocks New Work",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "uncappable_rate_multiplier": {
      "const": "2",
      "default": "2",
      "title": "Uncappable Rate Multiplier",
      "type": "string"
    },
    "unknown_billing_blocks_new_work": {
      "const": true,
      "default": true,
      "title": "Unknown Billing Blocks New Work",
      "type": "boolean"
    }
  },
  "required": [
    "policy_sha256"
  ],
  "title": "RouteCostReservationPolicy",
  "type": "object"
}
