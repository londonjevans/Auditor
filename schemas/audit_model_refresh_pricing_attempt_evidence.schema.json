{
  "$defs": {
    "EndpointRequestCostComponentEvidence": {
      "additionalProperties": false,
      "description": "Durable exact projection of one request cost-bound component.",
      "properties": {
        "maximum_units": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Maximum Units",
          "type": "integer"
        },
        "pricing_field": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Pricing Field",
          "type": "string"
        },
        "unit_price_usd_exact": {
          "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
          "title": "Unit Price Usd Exact",
          "type": "string"
        }
      },
      "required": [
        "pricing_field",
        "unit_price_usd_exact",
        "maximum_units"
      ],
      "title": "EndpointRequestCostComponentEvidence",
      "type": "object"
    },
    "ExactRoutePrice": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/RoutePriceComponent"
        },
        "unit_price": {
          "maxLength": 49,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
          "title": "Unit Price",
          "type": "string"
        }
      },
      "required": [
        "component",
        "unit_price"
      ],
      "title": "ExactRoutePrice",
      "type": "object"
    },
    "ExactRoutePriceTier": {
      "additionalProperties": false,
      "description": "One ordered prompt-threshold tier of exact partial price replacements.",
      "properties": {
        "min_prompt_tokens": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Min Prompt Tokens",
          "type": "integer"
        },
        "pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Pricing",
          "type": "array"
        }
      },
      "required": [
        "min_prompt_tokens",
        "pricing"
      ],
      "title": "ExactRoutePriceTier",
      "type": "object"
    },
    "ExactRoutePricingSchedule": {
      "additionalProperties": false,
      "description": "Exact conditional pricing plus its conservative component-wise maximum.",
      "properties": {
        "base_pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Base Pricing",
          "type": "array"
        },
        "conservative_for_sub_threshold_prompts": {
          "const": true,
          "default": true,
          "title": "Conservative For Sub Threshold Prompts",
          "type": "boolean"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "maximum_pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Maximum Pricing",
          "type": "array"
        },
        "pricing_schedule_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pricing Schedule Sha256",
          "type": "string"
        },
        "projection_method": {
          "const": "MMAUDIT_TIERED_MAXIMUM_RATE_V1",
          "default": "MMAUDIT_TIERED_MAXIMUM_RATE_V1",
          "title": "Projection Method",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/ExactRoutePriceTier"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "base_pricing",
        "tiers",
        "maximum_pricing",
        "pricing_schedule_sha256",
        "evidence_sha256"
      ],
      "title": "ExactRoutePricingSchedule",
      "type": "object"
    },
    "OpenRouterPricingOverrideTier": {
      "additionalProperties": false,
      "description": "One ordered, threshold-conditional partial endpoint price replacement.",
      "properties": {
        "min_prompt_tokens": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Min Prompt Tokens",
          "type": "integer"
        },
        "prices": {
          "additionalProperties": {
            "maxLength": 49,
            "minLength": 1,
            "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
            "type": "string"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "audio",
              "completion",
              "input_audio_cache",
              "input_cache_read",
              "input_cache_write",
              "input_cache_write_1h",
              "prompt"
            ]
          },
          "title": "Prices",
          "type": "object"
        }
      },
      "required": [
        "min_prompt_tokens",
        "prices"
      ],
      "title": "OpenRouterPricingOverrideTier",
      "type": "object"
    },
    "ProviderPriceCapAlgorithm": {
      "enum": [
        "MMAUDIT_OPENROUTER_MAX_PRICE_CEILING_V1",
        "MMAUDIT_OPENROUTER_MAX_PRICE_REQUEST_UNITS_V2",
        "MMAUDIT_OPENROUTER_MAX_PRICE_PROMPT_DOMINATED_CACHE_WRITE_V3"
      ],
      "title": "ProviderPriceCapAlgorithm",
      "type": "string"
    },
    "RoutePredicateDisposition": {
      "enum": [
        "SATISFIED",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "RoutePredicateDisposition",
      "type": "string"
    },
    "RoutePredicateId": {
      "description": "The complete, ordered route-admission predicate inventory.",
      "enum": [
        "EXACT_MODEL_IDENTITY",
        "EXACT_PROVIDER_ENDPOINT",
        "PROVIDER_DISPLAY_NAME_INJECTIVITY",
        "OPERATIONAL_STATUS",
        "ZDR_ELIGIBILITY",
        "EMITS_MAX_TOKENS",
        "EMITS_TEMPERATURE",
        "EMITS_RESPONSE_FORMAT",
        "EMITS_REASONING",
        "MODEL_STRUCTURED_OUTPUT_MARKER",
        "ENDPOINT_STRUCTURED_OUTPUT_MARKER",
        "NATIVE_STRUCTURED_OUTPUT_MODE",
        "SINGLETON_EXACT_ROUTE",
        "AUTOMATIC_FALLBACK_DISABLED",
        "REASONING_POLICY_BINDING",
        "REASONING_CONTROL_BINDING",
        "REASONING_CONTROL_VALUES",
        "REASONING_EFFORT_SUPPORT",
        "PROMPT_CAPACITY_ENVELOPE",
        "OUTPUT_CAPACITY_ENVELOPE",
        "CONTEXT_CAPACITY_ENVELOPE",
        "METADATA_COMPLETION_CAPACITY",
        "PRICE_CAP_EXPRESSIBILITY",
        "PRICE_CAP_NO_WEAKER",
        "FROZEN_LIVE_EQUIVALENCE",
        "REGISTRY_SELECTION_HASH_CUSTODY",
        "REGISTRY_CONSTRAINT_HASH_CUSTODY",
        "EMPIRICAL_SCHEMA_CONFORMANCE",
        "TOKEN_DETAIL_REPORTING_CONVENTION"
      ],
      "title": "RoutePredicateId",
      "type": "string"
    },
    "RoutePredicateProfile": {
      "additionalProperties": false,
      "description": "Shared requirements for every exact AUTHRUNNER route.",
      "properties": {
        "accepted_operational_status": {
          "const": "0",
          "title": "Accepted Operational Status",
          "type": "string"
        },
        "allow_automatic_fallbacks": {
          "const": false,
          "title": "Allow Automatic Fallbacks",
          "type": "boolean"
        },
        "emitted_request_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Emitted Request Parameters",
          "type": "array"
        },
        "empirical_schema_conformance_disposition": {
          "$ref": "#/$defs/RoutePredicateDisposition"
        },
        "minimum_context_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Minimum Context Tokens",
          "type": "integer"
        },
        "minimum_prompt_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Minimum Prompt Tokens",
          "type": "integer"
        },
        "native_capability_marker": {
          "const": "structured_outputs",
          "title": "Native Capability Marker",
          "type": "string"
        },
        "predicate_ids": {
          "items": {
            "$ref": "#/$defs/RoutePredicateId"
          },
          "maxItems": 29,
          "minItems": 29,
          "title": "Predicate Ids",
          "type": "array"
        },
        "price_cap_algorithm": {
          "$ref": "#/$defs/ProviderPriceCapAlgorithm"
        },
        "price_component_unit_envelopes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RoutePriceComponentUnitEnvelope"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Component Unit Envelopes"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "reasoning_control_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Control Profile Sha256",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Effort"
        },
        "reasoning_exclude": {
          "title": "Reasoning Exclude",
          "type": "boolean"
        },
        "reasoning_max_tokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Max Tokens"
        },
        "reasoning_mode": {
          "enum": [
            "disabled",
            "default",
            "effort",
            "max_tokens"
          ],
          "title": "Reasoning Mode",
          "type": "string"
        },
        "reasoning_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Policy Sha256",
          "type": "string"
        },
        "reasoning_role_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Role Binding Sha256",
          "type": "string"
        },
        "reasoning_role_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reasoning Role Profile Sha256",
          "type": "string"
        },
        "require_singleton_route": {
          "const": true,
          "title": "Require Singleton Route",
          "type": "boolean"
        },
        "require_zdr": {
          "const": true,
          "title": "Require Zdr",
          "type": "boolean"
        },
        "required_completion_limit_source": {
          "const": "metadata",
          "title": "Required Completion Limit Source",
          "type": "string"
        },
        "required_completion_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 131072,
          "title": "Required Completion Tokens",
          "type": "integer"
        },
        "required_output_mode": {
          "const": "NATIVE_JSON_SCHEMA",
          "title": "Required Output Mode",
          "type": "string"
        },
        "required_output_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Required Output Tokens",
          "type": "integer"
        },
        "reserved_reasoning_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Reserved Reasoning Tokens",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "1.1",
            "1.2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "token_detail_convention_disposition": {
          "$ref": "#/$defs/RoutePredicateDisposition"
        }
      },
      "required": [
        "predicate_ids",
        "emitted_request_parameters",
        "native_capability_marker",
        "required_output_mode",
        "accepted_operational_status",
        "require_zdr",
        "require_singleton_route",
        "allow_automatic_fallbacks",
        "reasoning_policy_sha256",
        "reasoning_role_profile_sha256",
        "reasoning_role_binding_sha256",
        "reasoning_control_profile_sha256",
        "reasoning_mode",
        "reasoning_effort",
        "reasoning_exclude",
        "reserved_reasoning_tokens",
        "minimum_prompt_tokens",
        "required_output_tokens",
        "required_completion_tokens",
        "minimum_context_tokens",
        "required_completion_limit_source",
        "price_cap_algorithm",
        "empirical_schema_conformance_disposition",
        "token_detail_convention_disposition",
        "profile_sha256"
      ],
      "title": "RoutePredicateProfile",
      "type": "object"
    },
    "RoutePriceComponent": {
      "enum": [
        "completion",
        "image",
        "input_cache_read",
        "input_cache_write",
        "internal_reasoning",
        "prompt",
        "request",
        "web_search"
      ],
      "title": "RoutePriceComponent",
      "type": "string"
    },
    "RoutePriceComponentUnitEnvelope": {
      "additionalProperties": false,
      "description": "Self-hashed proof that one unsupported price component has zero reachable units.",
      "properties": {
        "component": {
          "const": "web_search",
          "title": "Component",
          "type": "string"
        },
        "emitted_request_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Emitted Request Parameters",
          "type": "array"
        },
        "enforcement_method": {
          "const": "MMAUDIT_EXACT_REQUEST_FIELD_ABSENCE_V1",
          "title": "Enforcement Method",
          "type": "string"
        },
        "envelope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Sha256",
          "type": "string"
        },
        "maximum_cost_usd_exact": {
          "const": "0",
          "title": "Maximum Cost Usd Exact",
          "type": "string"
        },
        "maximum_units": {
          "const": 0,
          "title": "Maximum Units",
          "type": "integer"
        },
        "prohibited_request_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Prohibited Request Fields",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "maximum_units",
        "maximum_cost_usd_exact",
        "enforcement_method",
        "emitted_request_parameters",
        "prohibited_request_fields",
        "envelope_sha256"
      ],
      "title": "RoutePriceComponentUnitEnvelope",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/audit_model_refresh_pricing_attempt_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-authorizing price and cost-bound custody for one provider attempt.\n\nThe record is safe to retain in usage and report artifacts. Its hashes prove\nstructural consistency only; they cannot recreate the live refresh or pricing\ncapabilities required at the transport boundary.",
  "properties": {
    "attempt_index": {
      "maximum": 32,
      "minimum": 1,
      "title": "Attempt Index",
      "type": "integer"
    },
    "attempt_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Attempt Request Id",
      "type": "string"
    },
    "authority_mode": {
      "const": "NON_AUTHORIZING_REQUEST_COST_BOUND",
      "default": "NON_AUTHORIZING_REQUEST_COST_BOUND",
      "title": "Authority Mode",
      "type": "string"
    },
    "baseline_pricing": {
      "maxProperties": 64,
      "minProperties": 2,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "maxLength": 49,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "title": "Baseline Pricing",
      "type": "object"
    },
    "baseline_pricing_overrides": {
      "items": {
        "$ref": "#/$defs/OpenRouterPricingOverrideTier"
      },
      "maxItems": 64,
      "title": "Baseline Pricing Overrides",
      "type": "array"
    },
    "baseline_pricing_schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRoutePricingSchedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_pricing_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Pricing Sha256",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/EndpointRequestCostComponentEvidence"
      },
      "maxItems": 64,
      "minItems": 2,
      "title": "Components",
      "type": "array"
    },
    "cost_bound_pricing_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cost Bound Pricing Snapshot Sha256",
      "type": "string"
    },
    "current_endpoint_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Endpoint Snapshot Sha256",
      "type": "string"
    },
    "current_pricing": {
      "maxProperties": 64,
      "minProperties": 2,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "maxLength": 49,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "title": "Current Pricing",
      "type": "object"
    },
    "current_pricing_overrides": {
      "items": {
        "$ref": "#/$defs/OpenRouterPricingOverrideTier"
      },
      "maxItems": 64,
      "title": "Current Pricing Overrides",
      "type": "array"
    },
    "current_pricing_schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRoutePricingSchedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_pricing_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Pricing Sha256",
      "type": "string"
    },
    "evidence_authority": {
      "const": "comparison_required",
      "default": "comparison_required",
      "title": "Evidence Authority",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "exact_model_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "title": "Exact Model Id",
      "type": "string"
    },
    "logical_request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Logical Request Id",
      "type": "string"
    },
    "maximum_cost_usd_exact": {
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?$",
      "title": "Maximum Cost Usd Exact",
      "type": "string"
    },
    "price_cap_algorithm": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderPriceCapAlgorithm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "price_component_unit_envelopes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RoutePriceComponentUnitEnvelope"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Component Unit Envelopes"
    },
    "pricing_authority_capability_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Authority Capability Sha256",
      "type": "string"
    },
    "pricing_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Evidence Sha256",
      "type": "string"
    },
    "pricing_expires_at": {
      "format": "date-time",
      "title": "Pricing Expires At",
      "type": "string"
    },
    "pricing_route_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Route Evidence Sha256",
      "type": "string"
    },
    "pricing_use_authorized": {
      "const": false,
      "default": false,
      "title": "Pricing Use Authorized",
      "type": "boolean"
    },
    "pricing_verified_at": {
      "format": "date-time",
      "title": "Pricing Verified At",
      "type": "string"
    },
    "provider_access_authorized": {
      "const": false,
      "default": false,
      "title": "Provider Access Authorized",
      "type": "boolean"
    },
    "provider_endpoint": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/-]{0,255}$",
      "title": "Provider Endpoint",
      "type": "string"
    },
    "provider_max_price": {
      "maxProperties": 4,
      "minProperties": 2,
      "patternProperties": {
        "^(?:completion|image|prompt|request)$": {
          "maxLength": 55,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,17}|(?:0|[1-9][0-9]{0,17})\\.[0-9]{0,35}[1-9])$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 10,
        "minLength": 1,
        "pattern": "^(?:completion|image|prompt|request)$"
      },
      "title": "Provider Max Price",
      "type": "object"
    },
    "provider_max_price_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Max Price Sha256",
      "type": "string"
    },
    "qualified_pricing_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qualified Pricing Snapshot Sha256",
      "type": "string"
    },
