{
  "$id": "https://mmaudit.local/schemas/release_run_verification_binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed result of two equal, independent verification passes.",
  "properties": {
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "effective_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effective Config Sha256",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "manifest_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest File Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "mismatches": {
      "maximum": 0,
      "minimum": 0,
      "title": "Mismatches",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "run_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Binding Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "current",
      "title": "Status",
      "type": "string"
    },
    "target_source_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Source Tree Sha256",
      "type": "string"
    },
    "verification_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification File Sha256",
      "type": "string"
    },
    "verification_file_size": {
      "maximum": 100000000,
      "minimum": 1,
      "title": "Verification File Size",
      "type": "integer"
    },
    "verification_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "run_id",
    "run_binding_sha256",
    "manifest_sha256",
    "manifest_file_sha256",
    "target_source_tree_sha256",
    "effective_config_sha256",
    "status",
    "mismatches",
    "verification_file_sha256",
    "verification_file_size",
    "verification_sha256",
    "observed_at",
    "binding_sha256"
  ],
  "title": "ReleaseRunVerificationBinding",
  "type": "object"
}
