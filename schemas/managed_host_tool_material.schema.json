        "python-runtime",
        "git",
        "sandbox-exec",
        "bubblewrap",
        "container-runtime",
        "rootless-toolchain-image",
        "hardhat-image-hardhat",
        "hardhat-image-node",
        "hardhat-image-loopback",
        "hardhat-reporter",
        "hardhat-reporter-inventory-schema",
        "hardhat-reporter-test-schema"
      ],
      "title": "ManagedToolchainRole",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/managed_host_tool_material.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-consistent direct-file material inventory, never installed-toolchain trust.",
  "properties": {
    "architecture_verified": {
      "const": false,
      "default": false,
      "title": "Architecture Verified",
      "type": "boolean"
    },
    "artifact_kind": {
      "const": "managed-host-tool-material",
      "default": "managed-host-tool-material",
      "title": "Artifact Kind",
      "type": "string"
    },
    "effective_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Effective Config Sha256",
      "type": "string"
    },
    "execution_evidence_verified": {
      "const": false,
      "default": false,
      "title": "Execution Evidence Verified",
      "type": "boolean"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManagedHostToolFile"
      },
      "maxItems": 21,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "image_side_attestation_verified": {
      "const": false,
      "default": false,
      "title": "Image Side Attestation Verified",
      "type": "boolean"
    },
    "independently_trusted": {
      "const": false,
      "default": false,
      "title": "Independently Trusted",
      "type": "boolean"
    },
    "installed_members_verified": {
      "const": false,
      "default": false,
      "title": "Installed Members Verified",
      "type": "boolean"
    },
    "managed_run_ready": {
      "const": false,
      "default": false,
      "title": "Managed Run Ready",
      "type": "boolean"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "required_roles": {
      "items": {
        "$ref": "#/$defs/ManagedToolchainRole"
      },
      "maxItems": 28,
      "minItems": 1,
      "title": "Required Roles",
      "type": "array"
    },
    "runtime_authority": {
      "const": false,
      "default": false,
      "title": "Runtime Authority",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Bundle Sha256",
      "type": "string"
    },
    "status": {
      "const": "DIRECT_HOST_FILES_PREPARED_NONAUTHORIZING",
      "default": "DIRECT_HOST_FILES_PREPARED_NONAUTHORIZING",
      "title": "Status",
      "type": "string"
    },
    "transitive_dependency_closure_verified": {
      "const": false,
      "default": false,
      "title": "Transitive Dependency Closure Verified",
      "type": "boolean"
    }
  },
  "required": [
    "source_bundle_sha256",
    "effective_config_sha256",
    "required_roles",
    "files",
    "manifest_sha256"
  ],
  "title": "mmaudit nonauthorizing direct host-file material inventory",
  "type": "object"
}
