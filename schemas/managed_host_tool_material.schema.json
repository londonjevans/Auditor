        "locator",
        "version",
        "sha256",
        "size"
      ],
      "title": "ManagedHostToolFile",
      "type": "object"
    },
    "ManagedToolchainRole": {
      "description": "Closed first-class managed identities covered by this declaration.",
      "enum": [
        "solc",
        "anvil",
        "semgrep",
        "gitleaks",
        "trivy",
        "osv-scanner",
        "codeql",
        "slither",
        "forge",
        "mythril",
