        "role": {
          "$ref": "#/$defs/ManagedToolchainRole"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 4294967296,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/ -]{0,199}$",
