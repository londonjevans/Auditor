{
  "$defs": {
    "DevelopmentAuditPlan": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "development_audit_plan",
          "default": "development_audit_plan",
          "title": "Artifact Kind",
          "type": "string"
        },
        "audit_complete": {
          "const": false,
          "default": false,
          "title": "Audit Complete",
          "type": "boolean"
        },
        "corpus_id": {
          "$ref": "#/$defs/DevelopmentCorpusId"
        },
        "corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpus Sha256",
          "type": "string"
        },
        "estimated_total_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 250.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Total Cost Usd"
        },
        "findings_validated": {
          "const": false,
          "default": false,
          "title": "Findings Validated",
          "type": "boolean"
        },
        "partition": {
          "const": "COMPLETE_PRIMARY_FILES_WITH_FULL_SHARED_CORPUS",
          "default": "COMPLETE_PRIMARY_FILES_WITH_FULL_SHARED_CORPUS",
          "title": "Partition",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "qualification_eligible": {
          "const": false,
          "default": false,
          "title": "Qualification Eligible",
          "type": "boolean"
        },
        "release_eligible": {
          "const": false,
          "default": false,
          "title": "Release Eligible",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/DevelopmentResponseVersion",
          "default": "1.0"
        },
        "shards": {
          "items": {
            "$ref": "#/$defs/DevelopmentAuditShardPlan"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Shards",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DevelopmentAuditSource"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "corpus_id",
        "corpus_sha256",
        "sources",
        "shards",
        "estimated_total_cost_usd",
        "plan_sha256"
      ],
      "title": "DevelopmentAuditPlan",
      "type": "object"
    },
    "DevelopmentAuditShardPlan": {
      "additionalProperties": false,
      "properties": {
        "context_corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Corpus Sha256",
          "type": "string"
        },
        "estimate": {
          "$ref": "#/$defs/DevelopmentCostEstimate"
        },
        "primary_filename": {
          "title": "Primary Filename",
          "type": "string"
        },
        "shard_id": {
          "pattern": "^file-0[123]$",
          "title": "Shard Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "shard_id",
        "primary_filename",
        "source_sha256",
        "context_corpus_sha256",
        "estimate"
      ],
      "title": "DevelopmentAuditShardPlan",
      "type": "object"
    },
    "DevelopmentAuditSource": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "line_count": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Line Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "sha256",
        "size",
        "line_count"
      ],
      "title": "DevelopmentAuditSource",
      "type": "object"
    },
    "DevelopmentCorpusId": {
      "enum": [
        "unit-ledger-a-v1",
        "unit-ledger-b-v1"
      ],
      "type": "string"
    },
    "DevelopmentCostComponent": {
      "additionalProperties": false,
      "description": "One observed rate and the deliberately conservative estimation allowance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/DevelopmentPriceField"
        },
        "estimated_unit_price_usd": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Unit Price Usd"
        },
        "estimated_units": {
          "maximum": 4000000,
          "minimum": 0,
          "title": "Estimated Units",
          "type": "integer"
        },
        "observed_unit_price_usd": {
          "anyOf": [
            {
              "exclusiveMaximum": 1000000000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Observed Unit Price Usd"
        }
      },
      "required": [
        "component",
        "observed_unit_price_usd",
        "estimated_unit_price_usd",
        "estimated_units"
      ],
      "title": "DevelopmentCostComponent",
      "type": "object"
    },
    "DevelopmentCostEstimate": {
      "additionalProperties": false,
      "description": "Non-qualifying explanatory output, not an admission or execution capability.",
      "properties": {
        "artifact_kind": {
          "const": "development_cost_estimate",
          "default": "development_cost_estimate",
          "title": "Artifact Kind",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/DevelopmentCostComponent"
          },
          "maxItems": 7,
          "minItems": 2,
          "title": "Components",
          "type": "array"
        },
        "endpoint_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Snapshot Sha256",
          "type": "string"
        },
        "estimated_cost_all_attempts_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost All Attempts Usd"
        },
        "estimated_cost_per_attempt_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Estimated Cost Per Attempt Usd"
        },
        "exact_model_id": {
          "title": "Exact Model Id",
          "type": "string"
        },
        "maximum_completion_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Maximum Completion Tokens",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/DevelopmentCostPolicy"
        },
        "provider_endpoint": {
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_enforced_ceiling": {
          "const": false,
          "default": false,
          "title": "Provider Enforced Ceiling",
          "type": "boolean"
        },
        "qualification_eligible": {
          "const": false,
          "default": false,
          "title": "Qualification Eligible",
          "type": "boolean"
        },
        "release_eligible": {
          "const": false,
          "default": false,
          "title": "Release Eligible",
          "type": "boolean"
        },
        "request_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 4000000,
          "title": "Request Bytes",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "warning": {
          "const": "DEVELOPMENT ONLY: estimated costs may exceed reservations and the budget target. This is not a provider-enforced ceiling or qualification/release evidence.",
          "default": "DEVELOPMENT ONLY: estimated costs may exceed reservations and the budget target. This is not a provider-enforced ceiling or qualification/release evidence.",
          "title": "Warning",
          "type": "string"
        },
        "within_estimated_budget": {
          "title": "Within Estimated Budget",
          "type": "boolean"
        }
      },
      "required": [
        "policy",
        "request_id",
        "request_sha256",
        "endpoint_snapshot_sha256",
        "exact_model_id",
        "provider_endpoint",
        "request_bytes",
        "maximum_completion_tokens",
        "components",
        "estimated_cost_per_attempt_usd",
        "estimated_cost_all_attempts_usd",
        "within_estimated_budget"
      ],
      "title": "DevelopmentCostEstimate",
      "type": "object"
    },
    "DevelopmentCostPolicy": {
      "additionalProperties": false,
      "description": "Explicit target budgets, not hard guarantees; defaults keep retries off.",
      "properties": {
        "maximum_attempts": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "overspend_risk_accepted": {
          "const": true,
          "title": "Overspend Risk Accepted",
          "type": "boolean"
        },
        "per_attempt_budget_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Per Attempt Budget Usd",
          "type": "string"
        },
        "purpose": {
          "const": "DEVELOPMENT_ONLY_ESTIMATED",
          "default": "DEVELOPMENT_ONLY_ESTIMATED",
          "title": "Purpose",
          "type": "string"
        },
        "request_timeout_seconds": {
          "anyOf": [
            {
              "maximum": 1800,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Timeout Seconds"
        },
        "safety_multiplier": {
          "default": "2",
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Safety Multiplier",
          "type": "string"
        },
        "total_budget_usd": {
          "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,18})?$",
          "title": "Total Budget Usd",
          "type": "string"
        },
        "uncertain_cost_policy": {
          "default": "STOP",
          "enum": [
            "STOP",
            "CARRY_RESERVED_ESTIMATE"
          ],
          "title": "Uncertain Cost Policy",
          "type": "string"
        }
      },
      "required": [
        "overspend_risk_accepted",
        "total_budget_usd",
        "per_attempt_budget_usd"
      ],
      "title": "DevelopmentCostPolicy",
      "type": "object"
    },
    "DevelopmentEnsembleReviewer": {
      "additionalProperties": false,
      "properties": {
        "maximum_completion_tokens": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Maximum Completion Tokens",
          "type": "integer"
        },
        "routing": {
          "$ref": "#/$defs/DevelopmentRoutingContext"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "stage_id": {
          "$ref": "#/$defs/DevelopmentEnsembleReviewerId"
        }
      },
      "required": [
        "stage_id",
        "run_id",
        "routing",
        "maximum_completion_tokens"
      ],
      "title": "DevelopmentEnsembleReviewer",
      "type": "object"
    },
    "DevelopmentEnsembleReviewerId": {
      "enum": [
        "review-01",
        "review-02"
      ],
      "type": "string"
    },
    "DevelopmentPriceField": {
      "enum": [
        "prompt",
        "completion",
        "input_cache_read",
        "input_cache_write",
        "request",
        "image",
        "web_search"
      ],
      "type": "string"
    },
    "DevelopmentResponseVersion": {
      "enum": [
        "1.0",
        "2.0"
      ],
      "type": "string"
    },
    "DevelopmentRoutingContext": {
      "additionalProperties": false,
      "description": "Supplied request/discovery binding, not independently authenticated provider evidence.",
      "properties": {
        "canonical_model_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Model Id"
        },
        "catalog_identity_binding_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Identity Binding Sha256"
        },
        "endpoint_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Snapshot Sha256",
          "type": "string"
        },
        "exact_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Exact Model Id",
          "type": "string"
        },
        "identity_basis": {
          "enum": [
            "REQUEST_ID_ONLY",
            "SUPPLIED_DISCOVERY_BOUND"
          ],
          "title": "Identity Basis",
          "type": "string"
        },
        "model_metadata_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Metadata Snapshot Sha256"
        },
        "provider_endpoint": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        }
      },
      "required": [
        "exact_model_id",
        "provider_endpoint",
        "provider_name",
        "endpoint_snapshot_sha256",
        "identity_basis"
      ],
      "title": "DevelopmentRoutingContext",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/development_ensemble_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Candidate plus two independent prompts, not evidence of independent root lineages.",
  "properties": {
    "artifact_kind": {
      "const": "development_ensemble_plan",
      "default": "development_ensemble_plan",
      "title": "Artifact Kind",
      "type": "string"
    },
    "audit_complete": {
      "const": false,
      "default": false,
      "title": "Audit Complete",
      "type": "boolean"
    },
    "candidate": {
      "$ref": "#/$defs/DevelopmentAuditPlan"
    },
    "candidate_routing": {
      "$ref": "#/$defs/DevelopmentRoutingContext"
    },
    "consensus_policy": {
      "const": "TWO_REVIEW_UNANIMOUS_OPINION_ONLY",
      "default": "TWO_REVIEW_UNANIMOUS_OPINION_ONLY",
      "title": "Consensus Policy",
      "type": "string"
    },
    "estimated_headroom_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 250.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Headroom Usd"
    },
    "findings_validated": {
      "const": false,
      "default": false,
      "title": "Findings Validated",
      "type": "boolean"
    },
    "lineage_independence": {
      "const": "NOT_ESTABLISHED",
      "default": "NOT_ESTABLISHED",
      "title": "Lineage Independence",
      "type": "string"
    },
    "maximum_run_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 1800,
      "title": "Maximum Run Seconds",
      "type": "number"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "qualification_eligible": {
      "const": false,
      "default": false,
      "title": "Qualification Eligible",
      "type": "boolean"
    },
    "release_eligible": {
      "const": false,
      "default": false,
      "title": "Release Eligible",
      "type": "boolean"
    },
    "reviewers": {
      "items": {
        "$ref": "#/$defs/DevelopmentEnsembleReviewer"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Reviewers",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "candidate",
    "candidate_routing",
    "reviewers",
    "maximum_run_seconds",
    "estimated_headroom_usd",
    "plan_sha256"
  ],
  "title": "DevelopmentEnsemblePlan",
  "type": "object"
}
