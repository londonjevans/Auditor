{
  "$defs": {
    "DevelopmentResponseFailureReason": {
      "enum": [
        "CONTENT_ENCODING",
        "CONTENT_LENGTH",
        "RESPONSE_SIZE",
        "RESPONSE_JSON",
        "GENERATION_ID",
        "COMPLETION_OBJECT",
        "USAGE",
        "TOKEN_COUNTS",
        "SERVER_TOOLS",
        "CHOICES",
        "CHOICE_INDEX",
        "MESSAGE",
        "STRUCTURED_OUTPUT",
        "FINDING_LINE_BOUNDS",
        "ORIGIN_FILE_SCOPE",
        "ORIGIN_LINE_BOUNDS"
      ],
      "title": "DevelopmentResponseFailureReason",
      "type": "string"
    },
    "DevelopmentResponseField": {
      "enum": [
        "response",
        "schema_version",
        "summary",
        "findings",
        "finding",
        "title",
        "severity",
        "line_start",
        "line_end",
        "kind",
        "vulnerability_class",
        "violated_invariant",
        "root_cause_ref",
        "root_cause_ref.filename",
        "root_cause_ref.line_start",
        "root_cause_ref.line_end",
        "explanation",
        "recommendation"
      ],
      "title": "DevelopmentResponseField",
      "type": "string"
    },
    "DevelopmentSchemaConstraint": {
      "enum": [
        "REQUIRED_FIELD",
        "EXTRA_FIELD",
        "FIELD_TYPE",
        "ENUM_VALUE",
        "FIELD_BOUND",
        "FIELD_FORMAT",
        "LINE_ORDER",
        "ADVISORY_FIELD_MUST_BE_NULL",
        "INVARIANT_FIELD_MUST_BE_SET",
        "SCHEMA_CONSTRAINT"
      ],
      "title": "DevelopmentSchemaConstraint",
      "type": "string"
    },
    "DevelopmentSchemaIssue": {
      "additionalProperties": false,
      "description": "A known schema coordinate, never an input-authored key, value or error message.",
      "properties": {
        "constraint": {
          "$ref": "#/$defs/DevelopmentSchemaConstraint"
        },
        "field": {
          "$ref": "#/$defs/DevelopmentResponseField"
        },
        "finding_index": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finding Index"
        }
      },
      "required": [
        "constraint",
        "field",
        "finding_index"
      ],
      "title": "DevelopmentSchemaIssue",
      "type": "object"
    },
    "StructuredOutputFailureCode": {
      "description": "Non-secret classification for one rejected structured response.",
      "enum": [
        "TRUNCATED_RESPONSE",
        "INVALID_JSON_SYNTAX",
        "DUPLICATE_OBJECT_KEY",
        "NON_FINITE_NUMBER",
        "SCHEMA_VALIDATION_FAILED"
      ],
      "title": "StructuredOutputFailureCode",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/development_response_rejection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hash-bound refusal detail, meaningful only with its incomplete parent observation.",
  "properties": {
    "field": {
      "anyOf": [
        {
          "$ref": "#/$defs/DevelopmentResponseField"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finding_index": {
      "anyOf": [
        {
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Index"
    },
    "reason": {
      "$ref": "#/$defs/DevelopmentResponseFailureReason"
    },
    "response_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Sha256"
    },
    "schema_issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DevelopmentSchemaIssue"
      },
      "maxItems": 8,
      "title": "Schema Issues",
      "type": "array"
    },
    "schema_issues_truncated": {
      "default": false,
      "title": "Schema Issues Truncated",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "enum": [
        "HTTP_BODY",
        "COMPLETION_ENVELOPE",
        "STRUCTURED_OUTPUT",
        "SOURCE_SCOPE"
      ],
      "title": "Stage",
      "type": "string"
    },
    "structured_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredOutputFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "stage",
    "reason"
  ],
  "title": "DevelopmentResponseRejection",
  "type": "object"
}
