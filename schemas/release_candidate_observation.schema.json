{
  "$id": "https://mmaudit.local/schemas/release_candidate_observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed evidence for one exact, fully tracked clean candidate.",
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_tree_object": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Tree Object",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "git_object_format": {
      "enum": [
        "sha1",
        "sha256"
      ],
      "title": "Git Object Format",
      "type": "string"
    },
    "observation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tracked_file_bytes": {
      "maximum": 4294967296,
      "minimum": 0,
      "title": "Tracked File Bytes",
      "type": "integer"
    },
    "tracked_file_count": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Tracked File Count",
      "type": "integer"
    },
    "tracked_source_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tracked Source Inventory Sha256",
      "type": "string"
    },
    "worktree_clean": {
      "const": true,
      "title": "Worktree Clean",
      "type": "boolean"
    },
    "worktree_status_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Worktree Status Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "candidate_commit",
    "git_object_format",
    "candidate_tree_object",
    "tracked_source_inventory_sha256",
    "tracked_file_count",
    "tracked_file_bytes",
    "worktree_clean",
    "worktree_status_sha256",
    "observed_at",
    "observation_sha256"
  ],
  "title": "ReleaseCandidateObservation",
  "type": "object"
}
