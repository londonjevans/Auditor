{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmaudit.local/schemas/dependency_sbom.schema.json",
  "title": "mmaudit dependency SBOM artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "documents": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bomFormat",
          "specVersion",
          "serialNumber",
          "version",
          "project_root",
          "lockfile_sha256",
          "snapshot_sha256",
          "components"
        ],
        "properties": {
          "bomFormat": {
            "const": "CycloneDX"
          },
          "specVersion": {
            "const": "1.5"
          },
          "serialNumber": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f-]{36}$"
          },
          "version": {
            "const": 1
          },
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "lockfile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "bom-ref",
                "name",
                "version",
                "purl",
                "sha256",
                "integrity"
              ],
              "properties": {
                "type": {
                  "const": "library"
                },
                "bom-ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 214
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "purl": {
                  "type": "string",
                  "pattern": "^pkg:npm/",
                  "maxLength": 1000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "integrity": {
                  "type": "string",
                  "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$",
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    }
  }
}
