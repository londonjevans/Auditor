{
  "$defs": {
    "ExecutionEvidenceKind": {
      "description": "Whether a runtime record came from a real process or a test double.",
      "enum": [
        "real",
        "mock",
        "unverified"
      ],
      "title": "ExecutionEvidenceKind",
      "type": "string"
    },
    "ManifestFileBinding": {
      "additionalProperties": false,
      "description": "Hash and size for one normalized source or run-artifact path.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ManifestFileBinding",
      "type": "object"
    },
    "ReleaseGateId": {
      "description": "The exact fixed twelve-gate release portfolio.",
      "enum": [
        "artifacts",
        "benchmark_certificate",
        "doctor",
        "manifests",
        "maximum_assurance_run",
        "model_benchmark",
        "mypy",
        "pytest",
        "replay",
        "ruff_check",
        "ruff_format",
        "schemas"
      ],
      "title": "ReleaseGateId",
      "type": "string"
    },
    "ReleaseGatePrerequisiteBlocker": {
      "additionalProperties": false,
      "description": "Typed reason that a real prerequisite could not execute.",
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,99}$",
          "title": "Code",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ReleaseGatePrerequisiteBlocker",
      "type": "object"
    },
    "ReleaseGateReceipt": {
      "additionalProperties": false,
      "description": "One immutable-by-hash runtime receipt.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "argv_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Argv Sha256",
          "type": "string"
        },
        "artifact_bindings": {
          "items": {
            "$ref": "#/$defs/ManifestFileBinding"
          },
          "maxItems": 1000,
          "title": "Artifact Bindings",
          "type": "array"
        },
        "candidate_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Observation Sha256",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "execution_evidence": {
          "$ref": "#/$defs/ExecutionEvidenceKind"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": -255,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "fixed_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixed Plan Sha256",
          "type": "string"
        },
        "gate_id": {
          "$ref": "#/$defs/ReleaseGateId"
        },
        "generated_by": {
          "const": "mmaudit",
          "title": "Generated By",
          "type": "string"
        },
        "prerequisite_blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseGatePrerequisiteBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_summary": {
          "$ref": "#/$defs/ReleaseGateResultSummary"
        },
        "run_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Binding Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReleaseGateStatus"
        },
        "stderr_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stderr Sha256",
          "type": "string"
        },
        "stderr_size": {
          "maximum": 4194304,
          "minimum": 0,
          "title": "Stderr Size",
          "type": "integer"
        },
        "stdout_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stdout Sha256",
          "type": "string"
        },
        "stdout_size": {
          "maximum": 4194304,
          "minimum": 0,
          "title": "Stdout Size",
          "type": "integer"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "tool_distribution_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Distribution Sha256"
        },
        "tool_executable_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Executable Sha256"
        },
        "tool_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "schema_version",
        "generated_by",
        "gate_id",
        "candidate_observation_sha256",
        "run_binding_sha256",
        "fixed_plan_sha256",
        "status",
        "started_at",
        "ended_at",
        "argv",
        "argv_sha256",
        "tool_name",
        "execution_evidence",
        "timed_out",
        "stdout_size",
        "stdout_sha256",
        "stderr_size",
        "stderr_sha256",
        "result_summary",
        "prerequisite_blocker",
        "receipt_sha256"
      ],
      "title": "ReleaseGateReceipt",
      "type": "object"
    },
    "ReleaseGateResultKind": {
      "description": "Machine-readable outcome represented by a gate result summary.",
      "enum": [
        "passed",
        "failed",
        "timed_out",
        "blocked_technical"
      ],
      "title": "ReleaseGateResultKind",
      "type": "string"
    },
    "ReleaseGateResultSummary": {
      "additionalProperties": false,
      "description": "Bounded structured summary without retaining command output.",
      "properties": {
        "checks_failed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Failed",
          "type": "integer"
        },
        "checks_passed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Passed",
          "type": "integer"
        },
        "checks_total": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Total",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ReleaseGateResultKind"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary",
        "checks_total",
        "checks_passed",
        "checks_failed"
      ],
      "title": "ReleaseGateResultSummary",
      "type": "object"
    },
    "ReleaseGateStatus": {
      "description": "One derived gate outcome.",
      "enum": [
        "passed",
        "blocked_technical",
        "failed"
      ],
      "title": "ReleaseGateStatus",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/release_gate_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-hashed fixed release-gate evidence bundle.",
  "properties": {
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "candidate_observation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Observation Sha256",
      "type": "string"
    },
    "generated_by": {
      "const": "mmaudit",
      "title": "Generated By",
      "type": "string"
    },
    "receipt_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Set Sha256",
      "type": "string"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/ReleaseGateReceipt"
      },
      "maxItems": 12,
      "minItems": 12,
      "title": "Receipts",
      "type": "array"
    },
    "run_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Binding Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "candidate_observation_sha256",
    "run_binding_sha256",
    "receipts",
    "receipt_set_sha256",
    "bundle_sha256"
  ],
  "title": "ReleaseGateEvidenceBundle",
  "type": "object"
}
