{
  "$defs": {
    "PolicyEligibilityRoute": {
      "additionalProperties": false,
      "description": "One exact model/provider/endpoint identity.",
      "properties": {
        "exact_model_id": {
          "title": "Exact Model Id",
          "type": "string"
        },
        "provider_endpoint": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "route_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "exact_model_id",
        "provider_name",
        "provider_endpoint",
        "route_sha256"
      ],
      "title": "PolicyEligibilityRoute",
      "type": "object"
    },
    "PolicyEligibilitySourceCommitment": {
      "additionalProperties": false,
      "description": "Per-reference current source observations for one exact eligible route.",
      "properties": {
        "commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment Sha256",
          "type": "string"
        },
        "determination_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Determination Sha256",
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/PolicyEligibilityRoute"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_reference_observations": {
          "items": {
            "$ref": "#/$defs/PolicyEligibilitySourceReferenceObservation"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Reference Observations",
          "type": "array"
        }
      },
      "required": [
        "route",
        "determination_sha256",
        "source_reference_observations",
        "commitment_sha256"
      ],
      "title": "PolicyEligibilitySourceCommitment",
      "type": "object"
    },
    "PolicyEligibilitySourceReferenceObservation": {
      "additionalProperties": false,
      "description": "One explicit current-content observation for one cited official reference.",
      "properties": {
        "current_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Content Sha256",
          "type": "string"
        },
        "expected_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Content Sha256",
          "type": "string"
        },
        "observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reference_sha256",
        "expected_content_sha256",
        "current_content_sha256",
        "observation_sha256"
      ],
      "title": "PolicyEligibilitySourceReferenceObservation",
      "type": "object"
    }
  },
  "$id": "https://mmaudit.local/schemas/policy_eligibility_source_observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded current-source observation required at issue and every use.",
  "properties": {
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "observation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Sha256",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commitment_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Commitment Set Sha256",
      "type": "string"
    },
    "source_commitments": {
      "items": {
        "$ref": "#/$defs/PolicyEligibilitySourceCommitment"
      },
      "maxItems": 128,
      "minItems": 0,
      "title": "Source Commitments",
      "type": "array"
    }
  },
  "required": [
    "artifact_sha256",
    "observed_at",
    "expires_at",
    "source_commitments",
    "source_commitment_set_sha256",
    "observation_sha256"
  ],
  "title": "mmaudit current policy eligibility source observation",
  "type": "object"
}
