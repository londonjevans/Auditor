{
  "$defs": {
    "ExactRoutePrice": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/RoutePriceComponent"
        },
        "unit_price": {
          "maxLength": 49,
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
          "title": "Unit Price",
          "type": "string"
        }
      },
      "required": [
        "component",
        "unit_price"
      ],
      "title": "ExactRoutePrice",
      "type": "object"
    },
    "ExactRoutePriceTier": {
      "additionalProperties": false,
      "description": "One ordered prompt-threshold tier of exact partial price replacements.",
      "properties": {
        "min_prompt_tokens": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Min Prompt Tokens",
          "type": "integer"
        },
        "pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Pricing",
          "type": "array"
        }
      },
      "required": [
        "min_prompt_tokens",
        "pricing"
      ],
      "title": "ExactRoutePriceTier",
      "type": "object"
    },
    "ExactRoutePricingSchedule": {
      "additionalProperties": false,
      "description": "Exact conditional pricing plus its conservative component-wise maximum.",
      "properties": {
        "base_pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Base Pricing",
          "type": "array"
        },
        "conservative_for_sub_threshold_prompts": {
          "const": true,
          "default": true,
          "title": "Conservative For Sub Threshold Prompts",
          "type": "boolean"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "maximum_pricing": {
          "items": {
            "$ref": "#/$defs/ExactRoutePrice"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Maximum Pricing",
          "type": "array"
        },
        "pricing_schedule_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pricing Schedule Sha256",
          "type": "string"
        },
        "projection_method": {
          "const": "MMAUDIT_TIERED_MAXIMUM_RATE_V1",
          "default": "MMAUDIT_TIERED_MAXIMUM_RATE_V1",
          "title": "Projection Method",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/ExactRoutePriceTier"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "base_pricing",
        "tiers",
        "maximum_pricing",
        "pricing_schedule_sha256",
        "evidence_sha256"
      ],
      "title": "ExactRoutePricingSchedule",
      "type": "object"
    },
    "LiveCatalogModelState": {
      "additionalProperties": false,
      "description": "Schema-visible exact catalogue evidence required in a live snapshot.",
      "properties": {
        "canonical_model_slug": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Canonical Model Slug",
          "type": "string"
        },
        "catalog_context_limit": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Catalog Context Limit",
          "type": "integer"
        },
        "context_limit": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Context Limit",
          "type": "integer"
        },
        "context_limit_source": {
          "enum": [
            "metadata",
            "catalog_context"
          ],
          "title": "Context Limit Source",
          "type": "string"
        },
        "eligible_provider_endpoints": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Eligible Provider Endpoints",
          "type": "array"
        },
        "exact_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Exact Model Id",
          "type": "string"
        },
        "output_limit": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Output Limit",
          "type": "integer"
        },
        "output_limit_source": {
          "enum": [
            "metadata",
            "provider_context"
          ],
          "title": "Output Limit Source",
          "type": "string"
        },
        "reasoning_supported": {
          "title": "Reasoning Supported",
          "type": "boolean"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/LiveProviderRouteState"
          },
          "maxItems": 256,
          "title": "Routes",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256",
          "type": "string"
        },
        "structured_output_mode": {
          "$ref": "#/$defs/StructuredOutputMode"
        },
        "structured_output_supported": {
          "title": "Structured Output Supported",
          "type": "boolean"
        },
        "supported_output_modes": {
          "items": {
            "$ref": "#/$defs/StructuredOutputMode"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Supported Output Modes",
          "type": "array"
        },
        "supported_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Supported Parameters",
          "type": "array"
        },
        "variant_family_key": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Variant Family Key",
          "type": "string"
        }
      },
      "required": [
        "exact_model_id",
        "canonical_model_slug",
        "variant_family_key",
        "catalog_context_limit",
        "context_limit",
        "context_limit_source",
        "output_limit",
        "output_limit_source",
        "supported_parameters",
        "supported_output_modes",
        "structured_output_supported",
        "structured_output_mode",
        "reasoning_supported",
        "routes",
        "eligible_provider_endpoints",
        "state_sha256"
      ],
      "title": "LiveCatalogModelState",
      "type": "object"
    },
    "LiveProviderRouteState": {
      "additionalProperties": false,
      "description": "Schema-visible exact route evidence required in a live refresh snapshot.",
      "properties": {
        "context_limit": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Context Limit",
          "type": "integer"
        },
        "endpoint_slug": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Slug"
        },
        "endpoint_tag": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Tag"
        },
        "exact_model_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._:-]{0,255}$",
          "title": "Exact Model Id",
          "type": "string"
        },
        "max_prompt_tokens": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Max Prompt Tokens",
          "type": "integer"
        },
        "max_prompt_tokens_source": {
          "enum": [
            "metadata",
            "context_limit"
          ],
          "title": "Max Prompt Tokens Source",
          "type": "string"
        },
        "operational": {
          "title": "Operational",
          "type": "boolean"
        },
        "operational_status": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Operational Status",
          "type": "string"
        },
        "output_limit": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Output Limit",
          "type": "integer"
        },
        "output_limit_source": {
          "enum": [
            "metadata",
            "context_limit"
          ],
          "title": "Output Limit Source",
          "type": "string"
        },
        "pricing": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Pricing",
          "type": "object"
        },
        "pricing_observation": {
          "const": "EXACT",
          "title": "Pricing Observation",
          "type": "string"
        },
        "pricing_overrides": {
          "items": {
            "$ref": "#/$defs/OpenRouterPricingOverrideTier"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Pricing Overrides",
          "type": "array"
        },
        "pricing_schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRoutePricingSchedule"
            },
            {
              "const": "unavailable",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Schedule"
        },
        "pricing_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pricing Sha256",
          "type": "string"
        },
        "provider_endpoint": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Provider Endpoint",
          "type": "string"
        },
        "provider_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "reasoning_supported": {
          "title": "Reasoning Supported",
          "type": "boolean"
        },
        "route_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Sha256",
          "type": "string"
        },
        "routing_identity_unambiguous": {
          "title": "Routing Identity Unambiguous",
          "type": "boolean"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "structured_output_mode": {
          "$ref": "#/$defs/StructuredOutputMode"
        },
        "structured_output_supported": {
          "title": "Structured Output Supported",
          "type": "boolean"
        },
        "supported_output_modes": {
          "items": {
            "$ref": "#/$defs/StructuredOutputMode"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Supported Output Modes",
          "type": "array"
        },
        "supported_parameters": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Supported Parameters",
          "type": "array"
        },
        "zdr_eligible": {
          "title": "Zdr Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "exact_model_id",
        "provider_endpoint",
        "provider_name",
        "routing_identity_unambiguous",
        "operational",
        "operational_status",
        "zdr_eligible",
        "context_limit",
        "max_prompt_tokens",
        "max_prompt_tokens_source",
        "output_limit",
        "output_limit_source",
        "supported_parameters",
        "supported_output_modes",
        "structured_output_supported",
        "structured_output_mode",
        "reasoning_supported",
        "pricing_observation",
        "pricing",
        "pricing_sha256",
        "route_sha256"
      ],
      "title": "LiveProviderRouteState",
      "type": "object"
    },
    "OpenRouterPricingOverrideTier": {
      "additionalProperties": false,
      "description": "One ordered, threshold-conditional partial endpoint price replacement.",
      "properties": {
        "min_prompt_tokens": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Min Prompt Tokens",
          "type": "integer"
        },
        "prices": {
          "additionalProperties": {
            "maxLength": 49,
            "minLength": 1,
            "pattern": "^(?:0|[1-9][0-9]{0,11}|(?:0|[1-9][0-9]{0,11})\\.[0-9]{0,35}[1-9])$",
            "type": "string"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "audio",
              "completion",
              "input_audio_cache",
              "input_cache_read",
              "input_cache_write",
              "input_cache_write_1h",
              "prompt"
            ]
          },
          "title": "Prices",
          "type": "object"
        }
      },
      "required": [
        "min_prompt_tokens",
        "prices"
      ],
      "title": "OpenRouterPricingOverrideTier",
      "type": "object"
    },
    "RoutePriceComponent": {
      "enum": [
        "completion",
        "image",
        "input_cache_read",
        "input_cache_write",
        "internal_reasoning",
        "prompt",
        "request",
        "web_search"
      ],
      "title": "RoutePriceComponent",
      "type": "string"
    },
    "StructuredOutputMode": {
      "description": "One exact request/validation protocol for model output.",
      "enum": [
        "NATIVE_JSON_SCHEMA",
        "JSON_OBJECT",
        "VALIDATED_TEXT_JSON"
      ],
      "title": "StructuredOutputMode",
      "type": "string"
    }
  },
  "$id": "https://mmaudit.local/schemas/model_refresh_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete allowlisted semantic snapshot from one provider observation.",
  "properties": {
    "authenticated_metadata": {
      "const": true,
      "title": "Authenticated Metadata",
      "type": "boolean"
    },
    "candidate_registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Registry Sha256",
      "type": "string"
    },
    "catalog_model_count": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Catalog Model Count",
      "type": "integer"
    },
    "catalog_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Snapshot Sha256",
      "type": "string"
    },
    "excluded_routed_model_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Excluded Routed Model Ids",
      "type": "array"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/LiveCatalogModelState"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Sha256",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_api_identity": {
      "const": "https://openrouter.ai/api/v1",
      "default": "https://openrouter.ai/api/v1",
      "title": "Source Api Identity",
      "type": "string"
    },
    "source_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Evidence Sha256",
      "type": "string"
    },
    "zdr_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Zdr Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "retrieved_at",
    "authenticated_metadata",
    "candidate_registry_sha256",
    "source_evidence_sha256",
    "catalog_snapshot_sha256",
    "zdr_snapshot_sha256",
    "catalog_model_count",
    "excluded_routed_model_ids",
    "models",
    "semantic_sha256",
    "snapshot_sha256"
  ],
  "title": "mmaudit model refresh snapshot",
  "type": "object"
}
