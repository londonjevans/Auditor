          "type": "string"
        },
        "maximum_attempts": {
          "maximum": 32,
          "minimum": 1,
          "title": "Maximum Attempts",
          "type": "integer"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "schema_retry_failure_code": {
          "const": "SCHEMA_VALIDATION_FAILED",
          "default": "SCHEMA_VALIDATION_FAILED",
          "title": "Schema Retry Failure Code",
          "type": "string"
        },
        "schema_retry_route": {
          "const": "SAME_ROUTE",
          "default": "SAME_ROUTE",
          "title": "Schema Retry Route",
          "type": "string"
        },
        "schema_validation_retry_limit": {
          "maximum": 31,
          "minimum": 0,
          "title": "Schema Validation Retry Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "transient_retry_limit": {
          "maximum": 5,
          "minimum": 0,
          "title": "Transient Retry Limit",
          "type": "integer"
        },
        "transient_retry_scope": {
          "const": "NETWORK_OR_STATUS",
          "default": "NETWORK_OR_STATUS",
          "title": "Transient Retry Scope",
          "type": "string"
        }
      },
      "required": [
        "transient_retry_limit",
        "schema_validation_retry_limit",
        "maximum_attempts",
        "policy_sha256"
      ],
      "title": "ModelRetryPolicy",
      "type": "object"
    },
