{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmaudit.local/schemas/prior_audit.schema.json",
  "title": "mmaudit Blind-First Prior Audit Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "findings": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prior_id",
          "title",
          "severity",
          "previous_state",
          "locations"
        ],
        "properties": {
          "prior_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "severity": {
            "enum": ["informational", "low", "medium", "high", "critical"]
          },
          "cwe": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string"}
          },
          "previous_state": {
            "enum": ["open", "remediated"]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "start_line",
                "end_line",
                "historical_content_sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": ["string", "null"],
                  "maxLength": 200
                },
                "historical_content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "remediated_content_sha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "previous_state": {"const": "remediated"}
          },
          "required": ["previous_state"]
        },
        "then": {
          "properties": {
            "locations": {
              "items": {
                "required": ["remediated_content_sha256"]
              }
            }
          }
        }
      }
    }
  }
}
