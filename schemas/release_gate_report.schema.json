{
  "$defs": {
    "AuditProfile": {
      "enum": [
        "quick",
        "standard",
        "deep",
        "maximum-assurance"
      ],
      "title": "AuditProfile",
      "type": "string"
    },
    "ExecutionEvidenceKind": {
      "description": "Whether a runtime record came from a real process or a test double.",
      "enum": [
        "real",
        "mock",
        "unverified"
      ],
      "title": "ExecutionEvidenceKind",
      "type": "string"
    },
    "LanguageCapabilityProfile": {
      "description": "Explicit product capability selected independently of analysis depth.",
      "enum": [
        "solidity-evm",
        "generic-source-review"
      ],
      "title": "LanguageCapabilityProfile",
      "type": "string"
    },
    "LanguageCapabilityStatus": {
      "description": "Evidence-derived relationship between requested capability and audited source.",
      "enum": [
        "MATCHED",
        "REDUCED",
        "MISMATCH",
        "INCONCLUSIVE"
      ],
      "title": "LanguageCapabilityStatus",
      "type": "string"
    },
    "ManifestFileBinding": {
      "additionalProperties": false,
      "description": "Hash and size for one normalized source or run-artifact path.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ManifestFileBinding",
      "type": "object"
    },
    "ReleaseCandidateObservation": {
      "additionalProperties": false,
      "description": "Self-hashed evidence for one exact, fully tracked clean candidate.",
      "properties": {
        "candidate_commit": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Candidate Commit",
          "type": "string"
        },
        "candidate_tree_object": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Candidate Tree Object",
          "type": "string"
        },
        "generated_by": {
          "const": "mmaudit",
          "title": "Generated By",
          "type": "string"
        },
        "git_object_format": {
          "enum": [
            "sha1",
            "sha256"
          ],
          "title": "Git Object Format",
          "type": "string"
        },
        "observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tracked_file_bytes": {
          "maximum": 4294967296,
          "minimum": 0,
          "title": "Tracked File Bytes",
          "type": "integer"
        },
        "tracked_file_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Tracked File Count",
          "type": "integer"
        },
        "tracked_source_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tracked Source Inventory Sha256",
          "type": "string"
        },
        "worktree_clean": {
          "const": true,
          "title": "Worktree Clean",
          "type": "boolean"
        },
        "worktree_status_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Worktree Status Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "generated_by",
        "candidate_commit",
        "git_object_format",
        "candidate_tree_object",
        "tracked_source_inventory_sha256",
        "tracked_file_count",
        "tracked_file_bytes",
        "worktree_clean",
        "worktree_status_sha256",
        "observed_at",
        "observation_sha256"
      ],
      "title": "ReleaseCandidateObservation",
      "type": "object"
    },
    "ReleaseGateId": {
      "description": "The exact fixed twelve-gate release portfolio.",
      "enum": [
        "artifacts",
        "benchmark_certificate",
        "doctor",
        "manifests",
        "maximum_assurance_run",
        "model_benchmark",
        "mypy",
        "pytest",
        "replay",
        "ruff_check",
        "ruff_format",
        "schemas"
      ],
      "title": "ReleaseGateId",
      "type": "string"
    },
    "ReleaseGatePrerequisiteBlocker": {
      "additionalProperties": false,
      "description": "Typed reason that a real prerequisite could not execute.",
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,99}$",
          "title": "Code",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ReleaseGatePrerequisiteBlocker",
      "type": "object"
    },
    "ReleaseGateReportObservation": {
      "additionalProperties": false,
      "description": "Lossless public projection of one validated runtime gate receipt.",
      "properties": {
        "argv_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Argv Sha256",
          "type": "string"
        },
        "artifact_bindings": {
          "items": {
            "$ref": "#/$defs/ManifestFileBinding"
          },
          "maxItems": 1000,
          "title": "Artifact Bindings",
          "type": "array"
        },
        "artifact_bytes": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "artifact_count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Artifact Count",
          "type": "integer"
        },
        "artifact_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Inventory Sha256",
          "type": "string"
        },
        "candidate_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Observation Sha256",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "execution_evidence": {
          "$ref": "#/$defs/ExecutionEvidenceKind"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": -255,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "fixed_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixed Plan Sha256",
          "type": "string"
        },
        "gate_id": {
          "$ref": "#/$defs/ReleaseGateId"
        },
        "prerequisite_blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseGatePrerequisiteBlocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_summary": {
          "$ref": "#/$defs/ReleaseGateResultSummary"
        },
        "run_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Binding Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReleaseGateStatus"
        },
        "stderr_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stderr Sha256",
          "type": "string"
        },
        "stderr_size": {
          "minimum": 0,
          "title": "Stderr Size",
          "type": "integer"
        },
        "stdout_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stdout Sha256",
          "type": "string"
        },
        "stdout_size": {
          "minimum": 0,
          "title": "Stdout Size",
          "type": "integer"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "tool_distribution_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Distribution Sha256"
        },
        "tool_executable_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Executable Sha256"
        },
        "tool_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "gate_id",
        "status",
        "receipt_sha256",
        "candidate_observation_sha256",
        "run_binding_sha256",
        "fixed_plan_sha256",
        "started_at",
        "ended_at",
        "argv_sha256",
        "tool_name",
        "execution_evidence",
        "timed_out",
        "stdout_size",
        "stdout_sha256",
        "stderr_size",
        "stderr_sha256",
        "result_summary",
        "prerequisite_blocker",
        "artifact_bindings",
        "artifact_count",
        "artifact_bytes",
        "artifact_inventory_sha256"
      ],
      "title": "ReleaseGateReportObservation",
      "type": "object"
    },
    "ReleaseGateResultKind": {
      "description": "Machine-readable outcome represented by a gate result summary.",
      "enum": [
        "passed",
        "failed",
        "timed_out",
        "blocked_technical"
      ],
      "title": "ReleaseGateResultKind",
      "type": "string"
    },
    "ReleaseGateResultSummary": {
      "additionalProperties": false,
      "description": "Bounded structured summary without retaining command output.",
      "properties": {
        "checks_failed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Failed",
          "type": "integer"
        },
        "checks_passed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Passed",
          "type": "integer"
        },
        "checks_total": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Checks Total",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ReleaseGateResultKind"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary",
        "checks_total",
        "checks_passed",
        "checks_failed"
      ],
      "title": "ReleaseGateResultSummary",
      "type": "object"
    },
    "ReleaseGateStatus": {
      "description": "One derived gate outcome.",
      "enum": [
        "passed",
        "blocked_technical",
        "failed"
      ],
      "title": "ReleaseGateStatus",
      "type": "string"
    },
    "ReleaseReportInputBinding": {
      "additionalProperties": false,
      "description": "Exact file and inner-evidence identity for one fixed report input.",
      "properties": {
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "file_size": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "File Size",
          "type": "integer"
        },
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ReleaseReportInputRole"
        }
      },
      "required": [
        "role",
        "path",
        "file_sha256",
        "file_size",
        "evidence_sha256"
      ],
      "title": "ReleaseReportInputBinding",
      "type": "object"
    },
    "ReleaseReportInputRole": {
      "description": "Fixed typed inputs from which a release report is derived.",
      "enum": [
        "candidate",
        "gate_evidence",
        "run",
        "run_verification",
        "static_evidence"
      ],
      "title": "ReleaseReportInputRole",
      "type": "string"
    },
    "ReleaseRunBinding": {
      "additionalProperties": false,
      "description": "Self-hashed binding derived from two fresh observations of one run.",
      "properties": {
        "achieved_language_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageCapabilityProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "achieved_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Artifact Count",
          "type": "integer"
        },
        "artifact_evidence_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Evidence File Sha256",
          "type": "string"
        },
        "artifact_evidence_file_size": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Artifact Evidence File Size",
          "type": "integer"
        },
        "artifact_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Evidence Sha256",
          "type": "string"
        },
        "artifact_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Inventory Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "blocking_discovery_omissions": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Blocking Discovery Omissions",
          "type": "array"
        },
        "capability_status": {
          "$ref": "#/$defs/LanguageCapabilityStatus"
        },
        "cli_overrides_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cli Overrides Sha256",
          "type": "string"
        },
        "effective_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Config Sha256",
          "type": "string"
        },
        "environment_overrides_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Overrides Sha256",
          "type": "string"
        },
        "file_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Config Sha256",
          "type": "string"
        },
        "generated_by": {
          "const": "mmaudit",
          "title": "Generated By",
          "type": "string"
        },
        "invocation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Sha256",
          "type": "string"
        },
        "language_capability_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Language Capability Sha256",
          "type": "string"
        },
        "manifest_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest File Sha256",
          "type": "string"
        },
        "manifest_path": {
          "const": "run-evidence-manifest.json",
          "title": "Manifest Path",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "model_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Config Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reduced_language_capability": {
          "title": "Reduced Language Capability",
          "type": "boolean"
        },
        "requested_language_profile": {
          "$ref": "#/$defs/LanguageCapabilityProfile"
        },
        "requested_profile": {
          "$ref": "#/$defs/AuditProfile"
        },
        "run_configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Configuration Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_options_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Options Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_git_commit": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Git Commit"
        },
        "target_repository_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Repository Name",
          "type": "string"
        },
        "target_source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Source Tree Sha256",
          "type": "string"
        },
        "traceability_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Traceability Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "generated_by",
        "run_id",
        "target_repository_name",
        "target_git_commit",
        "target_source_tree_sha256",
        "manifest_path",
        "manifest_file_sha256",
        "manifest_sha256",
        "run_configuration_sha256",
        "file_config_sha256",
        "environment_overrides_sha256",
        "cli_overrides_sha256",
        "run_options_sha256",
        "effective_config_sha256",
        "model_config_sha256",
        "invocation_sha256",
        "requested_profile",
        "achieved_profile",
        "requested_language_profile",
        "achieved_language_profile",
        "capability_status",
        "reduced_language_capability",
        "blocking_discovery_omissions",
        "language_capability_sha256",
        "artifact_evidence_file_sha256",
        "artifact_evidence_file_size",
        "artifact_evidence_sha256",
        "artifact_inventory_sha256",
        "artifact_count",
        "traceability_sha256",
        "observed_at",
        "binding_sha256"
      ],
      "title": "ReleaseRunBinding",
      "type": "object"
    },
    "ReleaseRunVerificationBinding": {
      "additionalProperties": false,
      "description": "Self-hashed result of two equal, independent verification passes.",
      "properties": {
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "effective_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Config Sha256",
          "type": "string"
        },
        "generated_by": {
          "const": "mmaudit",
          "title": "Generated By",
          "type": "string"
        },
        "manifest_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest File Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "mismatches": {
          "maximum": 0,
          "minimum": 0,
          "title": "Mismatches",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "run_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Binding Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "current",
          "title": "Status",
          "type": "string"
        },
        "target_source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Source Tree Sha256",
          "type": "string"
        },
        "verification_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification File Sha256",
          "type": "string"
        },
        "verification_file_size": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Verification File Size",
          "type": "integer"
        },
        "verification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "generated_by",
        "run_id",
        "run_binding_sha256",
        "manifest_sha256",
        "manifest_file_sha256",
        "target_source_tree_sha256",
        "effective_config_sha256",
        "status",
        "mismatches",
        "verification_file_sha256",
        "verification_file_size",
        "verification_sha256",
        "observed_at",
        "binding_sha256"
      ],
      "title": "ReleaseRunVerificationBinding",
      "type": "object"
    },
    "ReleaseStatus": {
      "description": "Aggregate release outcome; only authoritative validation may certify it.",
      "enum": [
        "complete",
        "blocked_technical",
        "failed"
      ],
      "title": "ReleaseStatus",
      "type": "string"
    },
    "StaticReleaseEvidence": {
      "additionalProperties": false,
      "description": "Self-hashed static release validation evidence.",
      "properties": {
        "adversarial_cases": {
          "minimum": 1,
          "title": "Adversarial Cases",
          "type": "integer"
        },
        "adversarial_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adversarial Manifest Sha256",
          "type": "string"
        },
        "benchmark_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Benchmark Evidence Sha256",
          "type": "string"
        },
        "benchmark_source_bindings": {
          "minimum": 1,
          "title": "Benchmark Source Bindings",
          "type": "integer"
        },
        "candidate_commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Candidate Commit",
          "type": "string"
        },
        "candidate_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
