          "type": "integer"
        },
        "lineage_requirements_satisfied": {
          "title": "Lineage Requirements Satisfied",
          "type": "boolean"
        },
        "mandatory_responsibilities_satisfied": {
          "title": "Mandatory Responsibilities Satisfied",
          "type": "boolean"
        },
        "mandatory_reviewer_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Mandatory Reviewer Roles",
          "type": "array"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ModelSurfaceCoveragePolicy"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/ModelSurfaceCoverageRequirement"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "responsibility_seed_assignment_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Responsibility Seed Assignment Count",
          "type": "integer"
        },
        "reviewer_bindings": {
          "items": {
            "$ref": "#/$defs/ModelSurfaceReviewerBinding"
          },
          "maxItems": 256,
          "title": "Reviewer Bindings",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Surface Count",
          "type": "integer"
        },
        "surface_request_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Surface Request Manifest Sha256",
          "type": "string"
        },
        "task_count": {
          "maximum": 200000,
          "minimum": 0,
          "title": "Task Count",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ModelSurfaceGapTask"
          },
          "maxItems": 200000,
          "title": "Tasks",
          "type": "array"
        }
