        "policy",
        "surface_request_manifest_sha256",
        "requirements",
        "reviewer_bindings",
        "mandatory_reviewer_roles",
        "assignments",
        "tasks",
        "deficits",
        "surface_count",
        "lineage_gap_assignment_count",
        "responsibility_seed_assignment_count",
        "task_count",
        "lineage_requirements_satisfied",
        "mandatory_responsibilities_satisfied",
        "feasible",
        "plan_sha256"
