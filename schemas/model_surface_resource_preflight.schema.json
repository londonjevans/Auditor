    "ModelSurfaceAssignmentPurpose": {
      "description": "Why one reviewer/surface assignment exists in a gap-fill plan.",
      "enum": [
        "lineage_gap",
        "responsibility_seed"
      ],
      "title": "ModelSurfaceAssignmentPurpose",
      "type": "string"
    },
    "ModelSurfaceCoverageDeficit": {
      "additionalProperties": false,
      "description": "Exact remaining independent-root deficit for one mandatory surface.",
      "properties": {
        "artifact_kind": {
          "const": "model_surface_coverage_deficit",
          "default": "model_surface_coverage_deficit",
          "title": "Artifact Kind",
          "type": "string"
        },
        "assigned_root_lineages": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assigned Root Lineages",
          "type": "array"
        },
        "authorizes_dispatch": {
          "const": false,
          "default": false,
          "title": "Authorizes Dispatch",
          "type": "boolean"
        },
        "credited_root_lineages": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Credited Root Lineages",
          "type": "array"
        },
        "deficit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deficit Sha256",
          "type": "string"
        },
        "grants_completion_credit": {
          "const": false,
          "default": false,
          "title": "Grants Completion Credit",
          "type": "boolean"
        },
        "grants_review_credit": {
          "const": false,
          "default": false,
          "title": "Grants Review Credit",
          "type": "boolean"
        },
        "minimum_root_lineages": {
          "maximum": 16,
          "minimum": 1,
          "title": "Minimum Root Lineages",
          "type": "integer"
        },
        "missing_root_lineages": {
          "maximum": 16,
          "minimum": 1,
          "title": "Missing Root Lineages",
          "type": "integer"
        },
        "requirement_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requirement Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "surface_id": {
          "pattern": "^model-surface:[0-9a-f]{64}$",
          "title": "Surface Id",
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "requirement_sha256",
        "minimum_root_lineages",
        "credited_root_lineages",
        "assigned_root_lineages",
        "missing_root_lineages",
        "deficit_sha256"
      ],
      "title": "ModelSurfaceCoverageDeficit",
      "type": "object"
    },
