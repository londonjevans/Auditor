          "type": "array"
        },
        "authorizes_dispatch": {
          "const": false,
          "default": false,
          "title": "Authorizes Dispatch",
          "type": "boolean"
        },
        "deficits": {
          "items": {
            "$ref": "#/$defs/ModelSurfaceCoverageDeficit"
          },
          "maxItems": 10000,
          "title": "Deficits",
          "type": "array"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
