          "pattern": "^[0-9a-f]{64}$",
          "title": "Construction Manifest File Sha256",
          "type": "string"
        },
        "construction_source_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Construction Source Revision",
          "type": "string"
        },
        "origin_kind": {
          "const": "SYNTHETIC_PLANTED",
          "default": "SYNTHETIC_PLANTED",
          "title": "Origin Kind",
          "type": "string"
        },
        "origin_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Origin Sha256",
          "type": "string"
        },
        "regression_contract_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Regression Contract File Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "construction_source_revision",
        "construction_manifest_file_sha256",
        "construction_ground_truth_file_sha256",
        "regression_contract_file_sha256",
        "origin_sha256"
      ],
      "title": "SyntheticPlantedGroundTruthOrigin",
      "type": "object"
    },
    "_SmokeArtifactPath": {
      "enum": [
        "manifest.json",
        "ground_truth.json",
        "provenance.json",
        "verdict_policy.json"
      ],
      "type": "string"
    }
  },
