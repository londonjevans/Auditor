    "FrozenGroundTruthCaseBinding": {
      "additionalProperties": false,
      "description": "Exact corpus, answer-key, source-excerpt, and origin join for one case.",
      "properties": {
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "corpus_case_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpus Case Sha256",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/GroundTruthDisposition"
        },
        "ground_truth_case_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ground Truth Case Sha256",
          "type": "string"
        },
        "origin": {
          "discriminator": {
            "mapping": {
              "PUBLIC_ESTABLISHED": "#/$defs/PublicEstablishedGroundTruthOrigin",
              "SYNTHETIC_PLANTED": "#/$defs/SyntheticPlantedGroundTruthOrigin"
            },
            "propertyName": "origin_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SyntheticPlantedGroundTruthOrigin"
            },
            {
              "$ref": "#/$defs/PublicEstablishedGroundTruthOrigin"
            }
          ],
          "title": "Origin"
        },
        "source_excerpt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Excerpt Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "disposition",
        "corpus_case_sha256",
        "ground_truth_case_sha256",
        "source_excerpt_sha256",
        "origin",
        "binding_sha256"
      ],
      "title": "FrozenGroundTruthCaseBinding",
      "type": "object"
    },
    "GroundTruthDisposition": {
      "description": "Canonical case outcome independently joined to benchmark truth.",
      "enum": [
        "VULNERABILITY",
        "SAFE",
        "INSUFFICIENT_CONTEXT"
      ],
      "title": "GroundTruthDisposition",
      "type": "string"
    },
    "PublicEstablishedGroundTruthOrigin": {
      "additionalProperties": false,
      "description": "Externally published finding bound to an immutable affected source revision.",
      "properties": {
        "authored_by_evaluated_process": {
          "const": false,
          "default": false,
          "title": "Authored By Evaluated Process",
          "type": "boolean"
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "origin_kind": {
          "const": "PUBLIC_ESTABLISHED",
          "default": "PUBLIC_ESTABLISHED",
          "title": "Origin Kind",
          "type": "string"
        },
        "origin_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Origin Sha256",
          "type": "string"
        },
        "public_finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
          "title": "Public Finding Id",
          "type": "string"
        },
        "publication_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Publication Artifact Sha256",
          "type": "string"
        },
        "publication_proof_kind": {
          "const": "EXTERNAL_TRANSPARENCY_INCLUSION",
          "default": "EXTERNAL_TRANSPARENCY_INCLUSION",
          "title": "Publication Proof Kind",
          "type": "string"
        },
        "publication_proof_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Publication Proof Sha256",
          "type": "string"
        },
        "publication_uri": {
          "maxLength": 2000,
          "minLength": 9,
          "title": "Publication Uri",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "upstream_source_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Upstream Source Revision",
          "type": "string"
        },
        "upstream_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Upstream Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "public_finding_id",
        "publication_uri",
        "published_at",
        "publication_artifact_sha256",
        "publication_proof_sha256",
        "upstream_source_revision",
        "upstream_source_sha256",
        "origin_sha256"
      ],
      "title": "PublicEstablishedGroundTruthOrigin",
      "type": "object"
    },
    "SyntheticPlantedGroundTruthOrigin": {
      "additionalProperties": false,
      "description": "Precommitted synthetic construction and its deterministic regression contract.",
      "properties": {
        "authored_by_evaluated_process": {
          "const": false,
          "default": false,
          "title": "Authored By Evaluated Process",
          "type": "boolean"
